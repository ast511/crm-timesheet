{
  "extends": "./tsconfig.json",
  // `prisma.config.ts` is CLI-only tooling. Excluding it keeps every build
  // input under `src/`, so tsc's inferred root stays `src` and the output
  // remains `dist/main.js` rather than `dist/src/main.js`.
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}

// Prisma schema for the CRM TimeSheet backend.
// Docs: https://pris.ly/d/prisma-schema

// `prisma-client` replaces the deprecated `prisma-client-js`: it emits plain
// TypeScript instead of a package inside node_modules, so `output` is required.
// The target sits under `src/` on purpose — tsc then compiles the client into
// `dist/` along with everything else, and the build output stays `dist/main.js`.
// The directory is gitignored; it is rebuilt by `prisma generate`.
// `moduleFormat` is stated rather than inferred to match tsconfig's "commonjs".
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// As of Prisma 7 the connection URL no longer belongs here. Migrate and Studio
// read it from `prisma.config.ts`; the application passes it to the driver
// adapter in `src/prisma/prisma.service.ts`. Both resolve DATABASE_URL.
// See https://www.prisma.io/docs/guides/upgrade-prisma-orm/v7
datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN @map("superadmin")
  ADMIN      @map("admin")
  HR         @map("hr")
  USER       @map("user")
}

enum EmployeeStatus {
  ACTIVE     @map("active")
  INACTIVE   @map("inactive")
  ON_LEAVE   @map("on_leave")
  SUSPENDED  @map("suspended")
  TERMINATED @map("terminated")
}

enum SeniorityLevel {
  INTERN @map("intern")
  JUNIOR @map("junior")
  MID    @map("mid")
  SENIOR @map("senior")
  LEAD   @map("lead")
}

/// Where a project is in its lifecycle. `ON_HOLD` is spelled with an
/// underscore, not a hyphen, to match `EmployeeStatus.ON_LEAVE` — the stored
/// value is what every query, export and enum literal has to repeat, so the two
/// vocabularies staying consistent matters more than the hyphen does.
enum ProjectStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  ON_HOLD   @map("on_hold")
  CANCELLED @map("cancelled")
}

enum ProjectPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

/// Whether a public holiday falls on the same calendar day every year, or has
/// to be stated for each year separately.
///
/// The values are stored lower-case like every other enum here, and the
/// distinction is not cosmetic: it decides which columns of `PublicHoliday`
/// carry meaning. For `FIXED` the year in `startDate` is disregarded and the
/// month and day are what recur; for `VARIABLE` the full dates are the fact,
/// and next year's occurrence is a different row.
enum HolidayType {
  FIXED    @map("fixed")
  VARIABLE @map("variable")
}

/// Where a leave request is in its lifecycle.
///
/// Four states and exactly one transition out of the first: `PENDING` may
/// become any of the other three, and none of those three becomes anything.
/// That is deliberate, and it is what makes "a decision never moves balances
/// back" a rule the state machine can keep rather than a promise the service
/// has to remember. See `LeaveRequestsService.decide` for the whole argument.
///
/// `CANCELLED` is a decision recorded against a request that was still waiting,
/// not an undo of an approval — an approved leave whose days have already been
/// deducted has no path back through this enum, because giving it one without
/// also releasing the days would leave the balance describing leave nobody took.
enum LeaveRequestStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
}

/// A day of the week, declared Monday-first because that is the order the
/// business works in and the order a European calendar renders. The
/// declaration order is not cosmetic: it is what `WorkSchedule.workingDays` is
/// sorted by, so the stored array always reads as a week rather than as the
/// order somebody happened to tick the boxes in.
enum Weekday {
  MONDAY    @map("monday")
  TUESDAY   @map("tuesday")
  WEDNESDAY @map("wednesday")
  THURSDAY  @map("thursday")
  FRIDAY    @map("friday")
  SATURDAY  @map("saturday")
  SUNDAY    @map("sunday")
}

/// Which of the two notification workspaces a message belongs to.
///
/// Not a role and not a permission: it is the *inbox* the message is filed in.
/// `PERSONAL` is what an employee reads about themselves — their leave was
/// approved, their timesheet is due. `ADMINISTRATIVE` is the back-office inbox
/// the people who run the company share: a request was submitted, an import
/// finished, a synchronisation failed.
///
/// The distinction is stored rather than derived from [Notification.recipientType]
/// even though the two are correlated, because they answer different questions
/// and only one of them is a *scope*: the workspace is what a URL selects and
/// what a "mark everything read" acts over, while the recipient type says how
/// one row inside it is addressed. Deriving either from the other would make
/// every list query reason about the mapping instead of naming the column.
enum NotificationWorkspace {
  PERSONAL       @map("personal")
  ADMINISTRATIVE @map("administrative")
}

/// How a notification names who it is for.
///
/// Four values, and exactly four pairings with [NotificationWorkspace] are
/// legal — `PERSONAL`+`USER`, `PERSONAL`+`ALL_USERS`,
/// `ADMINISTRATIVE`+`ROLE`, `ADMINISTRATIVE`+`ADMINISTRATIVE_USERS`. The other
/// four combinations are refused by `NotificationService`, not by a CHECK
/// constraint: the rule also governs which of `recipient_user_id` and
/// `recipient_role` must be set and which must be null, so stating half of it
/// in the schema would leave the readable half in the application anyway.
///
/// `ALL_USERS` and `ADMINISTRATIVE_USERS` are *broadcasts* — one row read by
/// many people — and both carry a null recipient. See [Notification.isRead] for
/// what that costs.
enum NotificationRecipientType {
  USER                 @map("user")
  ROLE                 @map("role")
  ALL_USERS            @map("all_users")
  ADMINISTRATIVE_USERS @map("administrative_users")
}

/// What the notification is *about* — the part of the system it came from.
///
/// A closed vocabulary rather than free text, because it is what a client
/// filters and groups by: "show me only leave notifications" has to be a query
/// parameter, not a substring search over a title somebody phrased.
///
/// Deliberately separate from [NotificationType], which says how *urgent* it
/// looks rather than where it came from. A rejected leave request is
/// `LEAVE`+`ERROR`; a completed import is `SYSTEM`+`SUCCESS`. Folding the two
/// into one column would make "every leave notification" unanswerable.
enum NotificationCategory {
  GENERAL     @map("general")
  SYSTEM      @map("system")
  TIMESHEET   @map("timesheet")
  LEAVE       @map("leave")
  REMINDER    @map("reminder")
  MAINTENANCE @map("maintenance")
}

/// How the notification is drawn — the severity a client renders it with.
///
/// Presentation rather than routing: it decides the colour and the icon, and
/// nothing in the application branches on it.
enum NotificationType {
  INFO    @map("info")
  SUCCESS @map("success")
  WARNING @map("warning")
  ERROR   @map("error")
}

/// How much the notification wants attention.
///
/// Declared low-to-high on purpose, and the order is not cosmetic: PostgreSQL
/// sorts an enum by its declaration order, so `?sortBy=priority&sortOrder=desc`
/// puts `HIGH` first because of this list. Spelled the same way and in the same
/// direction as `ProjectPriority`, so the two vocabularies cannot drift into
/// sorting opposite ways.
enum NotificationPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String? @unique

  passwordHash String @map("password_hash")

  role     UserRole @default(USER)
  isActive Boolean  @default(true) @map("is_active")

  employee Employee?

  /// Notifications addressed to this account by name.
  ///
  /// Only the `USER` recipient type points here. A broadcast — `ALL_USERS` or
  /// `ADMINISTRATIVE_USERS` — and a role-addressed notification both leave
  /// `recipient_user_id` null, so this relation is the *directly addressed*
  /// subset rather than everything a person can see.
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Employee {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  employeeCode String @unique @map("employee_code")

  firstName String @map("first_name")
  lastName  String @map("last_name")

  phone String?

  hireDate DateTime @map("hire_date")

  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])

  projectMemberships ProjectMember[]

  seniority SeniorityLevel

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  canReplaceOthers Boolean @default(false) @map("can_replace_others")

  status EmployeeStatus

  /// Leave granted to this person, one row per leave type per year.
  ///
  /// This replaces the `maxVacationDays` column Feature 010 put here. That
  /// column held one number for one unnamed kind of leave, with no year on it,
  /// so it could not say how many days somebody had in 2026 as opposed to 2027
  /// and could not say anything at all about medical or unpaid leave. The
  /// balances carry the year and the leave type, which is the grain HR actually
  /// grants in.
  leaveBalances EmployeeLeaveBalance[]

  /// Leave this person has asked for — the requests they own.
  leaveRequests LeaveRequest[]

  /// Leave requests this person decided on, as HR or an administrator.
  ///
  /// A second relation to the same table, which is why both ends carry an
  /// explicit name: without one Prisma cannot tell which foreign key each side
  /// belongs to. The two are genuinely different facts — `leaveRequests` is
  /// leave somebody asked for, this is leave somebody granted or refused — and
  /// a single relation could not express that one person may appear in both
  /// roles on different rows, which is exactly what happens when an HR manager
  /// books their own holiday.
  processedLeaveRequests LeaveRequest[] @relation("LeaveRequestProcessor")

  /// Requests naming this person as the one covering the work.
  leaveRequestReplacements LeaveRequestReplacement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

model Position {
  id   String @id @default(cuid())
  code String @unique

  name String @unique

  employees Employee[]

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("positions")
}

model Department {
  id   String @id @default(cuid())
  code String @unique

  name String @unique

  employees Employee[]

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Project {
  id String @id @default(cuid())

  code String @unique

  name String

  /// Customer the work is billed to. Required: an internal project names the
  /// company itself rather than leaving the column empty.
  clientName String @map("client_name")

  description String?

  /// Budgeted effort in whole hours. `0` means "not estimated yet", which is
  /// why the column has a default instead of being nullable.
  estimatedHours Int @default(0) @map("estimated_hours")

  /// UI accent, stored as `#RRGGBB`. Seven characters is exactly the format,
  /// so the length is part of the column rather than only an API rule.
  color String? @db.VarChar(7)

  /// Lifecycle state. Defaulted rather than required, so the column has an
  /// answer for the rows that existed before this feature and for a project
  /// created without an opinion about it.
  projectStatus ProjectStatus @default(ACTIVE) @map("project_status")

  /// Scheduling priority, defaulted to the middle of the scale for the same
  /// reason: an unstated priority is "normal", not "unknown".
  projectPriority ProjectPriority @default(MEDIUM) @map("project_priority")

  /// Hidden from normal listings without being deleted. A separate axis from
  /// `projectStatus`: a completed project and a cancelled one can both be
  /// archived, and the distinction between them survives the archiving.
  isArchived Boolean @default(false) @map("is_archived")

  memberships ProjectMember[]

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  projectId  String
  employeeId String

  isProjectManager Boolean @default(false) @map("is_project_manager")

  project Project @relation(fields: [projectId], references: [id])

  employee Employee @relation(fields: [employeeId], references: [id])

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  @@id([projectId, employeeId])
  @@map("project_members")
}

/// The company's working schedule — one row, for the whole application.
///
/// Configuration rather than data: it describes how the company works, not
/// something that happened. The Timesheets module will read it to decide
/// whether an entry is acceptable; nothing here computes anything.
///
/// **Only one row may exist**, and that is enforced by the primary key rather
/// than by the service alone. `id` has a constant default, so an INSERT that
/// does not name an id lands on the same key as the existing configuration and
/// is rejected as a duplicate primary key instead of quietly becoming a second
/// one. The literal is `WORK_SCHEDULE_ID` in
/// `src/modules/work-schedule/work-schedule.constants.ts`; the two must stay in
/// step, which is why both sides say so.
model WorkSchedule {
  id String @id @default("work_schedule")

  /// Which weekdays are working days. A PostgreSQL array of the `Weekday` enum,
  /// so the column itself rejects a value that is not a day of the week — a
  /// `String[]` would have accepted `"Funday"`. Held in `Weekday` declaration
  /// order; duplicates are rejected by the DTO, since an array column cannot
  /// express that.
  workingDays Weekday[] @map("working_days")

  /// `HH:mm`, 24-hour. Stored as text rather than as `time`, because the value
  /// is a wall-clock label — "the office opens at 09:00" — not an instant, and
  /// the `timestamp`-backed alternative would drag a date and a timezone along
  /// with it. `varchar(5)` is exactly the format's width, so the shape is part
  /// of the column and not only an API rule.
  workStartTime String @map("work_start_time") @db.VarChar(5)
  workEndTime   String @map("work_end_time") @db.VarChar(5)

  /// Hour bounds, as `decimal(5,2)` — never `double`.
  ///
  /// Half hours (`0.5`) and quarter hours (`0.25`) are the granularity people
  /// actually book, and these are the numbers the Timesheets module will
  /// compare against and sum. Binary floating point cannot hold `0.1` exactly,
  /// so a column of totals would drift by fractions of a second per row and a
  /// `>=` comparison at the boundary would come out differently depending on
  /// how the value was reached. `decimal` is exact for both.
  ///
  /// `(5, 2)` allows up to `999.99` with two decimals: comfortably past the 168
  /// hours in a week, and it makes a third decimal a rejected value rather than
  /// a silently rounded one.
  minHoursPerEntry Decimal @map("min_hours_per_entry") @db.Decimal(5, 2)
  maxHoursPerEntry Decimal @map("max_hours_per_entry") @db.Decimal(5, 2)
  maxHoursPerDay   Decimal @map("max_hours_per_day") @db.Decimal(5, 2)

  standardHoursPerDay  Decimal @map("standard_hours_per_day") @db.Decimal(5, 2)
  standardHoursPerWeek Decimal @map("standard_hours_per_week") @db.Decimal(5, 2)

  /// Informational only. It is recorded so a payroll export, a report or a
  /// future policy can state the company's lunch break, and it is deliberately
  /// subtracted from nothing: hours are what an employee books, and quietly
  /// removing an hour from a day somebody logged would make the stored total
  /// disagree with what they entered.
  lunchBreakHours Decimal @map("lunch_break_hours") @db.Decimal(5, 2)

  approvalEmails TimesheetApprovalEmail[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("work_schedules")
}

/// A day the company does not work — a legal holiday, or one it grants itself.
///
/// Configuration rather than data, like [WorkSchedule]: it describes when the
/// company is closed, not something that happened. The Timesheets and Vacations
/// modules will read it; nothing here computes anything, and in particular no
/// date is derived — Easter is entered, not calculated.
///
/// **A holiday is never deleted to switch it off, and never edited in place to
/// repeal it.** A row is one *version* of a holiday, valid over a range of
/// years; repealing closes the range and reinstating opens a new row. That is
/// what lets `/calendar/2026` report 2026 as it actually was — see
/// `validFromYear`.
///
/// There is no unique constraint. `name` cannot be one — "Easter" is a
/// different row in every year — and the rule that actually applies to `FIXED`
/// holidays is "one per month and day *among versions whose years overlap*",
/// which no unique index can state. `PublicHolidayService` enforces both
/// duplicate rules.
model PublicHoliday {
  id String @id @default(cuid())

  name        String
  description String?

  type HolidayType

  /// A legal holiday the whole country observes (`true`), or one this company
  /// grants on its own (`false`). Defaulted to `true` because the set this
  /// table is created to hold is the national calendar; a company day off is
  /// the deliberate exception.
  isNational Boolean @default(true) @map("is_national")

  /// The years this version of the holiday applies to, both ends inclusive and
  /// both open-ended when null: `validFromYear` null means "as far back as this
  /// system knows", `validToYear` null means "still in force".
  ///
  /// They replace the `isActive` boolean this model started with, and the
  /// reason is the bug that boolean had rather than a preference. A flag
  /// carries no date, so switching a holiday off in 2029 also removed it from
  /// the 2026 calendar — a year the office really was closed. A range says
  /// *when* it stopped, so the past keeps its answer.
  ///
  /// Only meaningful for `FIXED` holidays, and rejected on `VARIABLE` ones: a
  /// variable holiday's row already *is* one year, named by `startDate`, so a
  /// range on it would be a second, contradictable statement of the same fact.
  ///
  /// They say nothing about the year inside `startDate`, which stays
  /// meaningless for a fixed holiday. A version valid from 2029 may perfectly
  /// well store `2025-06-01`; only the month and day are read.
  validFromYear Int? @map("valid_from_year")
  validToYear   Int? @map("valid_to_year")

  /// The span the holiday covers, both ends inclusive. A one-day holiday stores
  /// the same date twice rather than leaving `endDate` null: every consumer then
  /// reads one shape, and "which days are closed" never has a special case.
  ///
  /// For a `FIXED` holiday only the month and day are meaningful; the year is
  /// whatever year it was first entered for, and the recurrence rule ignores it.
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  /// Derived from `type` — `true` for `FIXED`, `false` for `VARIABLE` — and
  /// stored anyway, so a report or an export can state the fact without also
  /// having to know the rule. The API keeps the two in step; the `false`
  /// default is the database's answer for rows written outside it.
  isRecurring Boolean @default(false) @map("is_recurring")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_holidays")
}

/// A kind of leave an employee can take — annual, medical, unpaid, and so on.
///
/// Configuration rather than data, like [WorkSchedule] and [PublicHoliday]: it
/// describes what leave the company recognises, not that anybody took any. No
/// employee, balance or request refers to it yet; the modules that introduce
/// those will point at this table rather than repeating its vocabulary.
///
/// Both `code` and `label` are unique, and they are unique for different
/// reasons. `code` is the natural key an export, an integration or a URL quotes
/// (`ANNUAL`); `label` is what a person reads on a form ("Annual Leave"), and
/// two rows sharing one would be indistinguishable on every screen that lists
/// them. `LeaveTypesService` folds case before either check, since PostgreSQL's
/// unique indexes do not.
model LeaveType {
  id String @id @default(cuid())

  code  String @unique
  label String @unique

  /// The *name* of an icon — `umbrella-beach`, `hospital`, `baby` — never the
  /// icon itself. A CSV export, a native app and a PDF report each need their
  /// own drawing of the same idea, and only the frontend knows which set it
  /// ships, so this column holds a key into that set rather than a picture.
  ///
  /// The API bounds the length (50) and requires it to be non-empty, and states
  /// nothing else about the spelling: icon sets disagree on one, and a pattern
  /// would reject whichever set the frontend actually uses.
  icon String

  /// UI accent, stored as `#RRGGBB`. Seven characters is exactly the format, so
  /// the length is part of the column rather than only an API rule — the same
  /// call `Project.color` makes.
  color String? @db.VarChar(7)

  description String?

  /// The number of days HR is *suggested* when it creates an employee's annual
  /// balance for this leave type.
  ///
  /// **Nothing is allocated by this column on its own.** It is a default, not an
  /// entitlement — Feature 024's generation seeds new balances from it, and HR
  /// may edit any of them afterwards: entitlement is per employee
  /// and per year — it depends on seniority, on the contract, on days carried
  /// over — and none of those facts live here. A balance table owned by that
  /// feature will hold the numbers that were actually granted, so changing this
  /// value never silently rewrites what somebody was already given.
  ///
  /// Nullable, because "no suggestion" is a real answer: medical leave is
  /// granted against a certificate rather than out of a pot, and `0` would claim
  /// an allocation of zero days instead.
  defaultAllocatedDays Int? @map("default_allocated_days")

  /// Whether days left over at the end of a year may still be taken in the next
  /// one.
  ///
  /// Defaulted to `false`, which is the conservative half of the pair: after the
  /// migration that adds this column, no type carries anything over until
  /// somebody says it does. Annual leave is the type this exists for; medical
  /// leave is granted against a certificate rather than out of a pot, so there is
  /// nothing to carry.
  ///
  /// **This column does not move days.** Balances are consumed oldest year
  /// first, so last year's remainder is already spendable — what Feature 024's
  /// generation writes off is the part that is *not* allowed to survive. See
  /// [EmployeeLeaveBalance.expiredDays].
  allowsCarryOver Boolean @default(false) @map("allows_carry_over")

  /// The most days that may survive one year-end, or `null` for no cap.
  ///
  /// Read only when [allowsCarryOver] is `true`; on a type that carries nothing
  /// over it would describe a limit on something that never happens. Kept
  /// nullable rather than defaulted to a number because "carries over, without a
  /// ceiling" is a real policy, and `0` would mean the opposite of it.
  maxCarryOverDays Int? @map("max_carry_over_days")

  /// Whether a request of this type has to be approved before it counts.
  /// Defaulted to `true` because approval is the norm — annual leave is agreed
  /// in advance — and the exception is deliberate: medical leave is notified,
  /// not requested. Read by the Leave Requests module; nothing here acts on it.
  requiresApproval Boolean @default(true) @map("requires_approval")

  /// Whether the days are paid. Defaulted to `true` for the same reason:
  /// unpaid leave is the exception that has to be stated.
  isPaid Boolean @default(true) @map("is_paid")

  /// Hidden from new requests without being deleted, so leave already recorded
  /// against a retired type keeps its meaning. A separate axis from `isPaid` and
  /// `requiresApproval`, which describe the type rather than its availability.
  isActive Boolean @default(true) @map("is_active")

  /// The per-employee, per-year grants of this kind of leave.
  ///
  /// The first relation into `leave_types`, and the reason Feature 021's note
  /// about `DELETE /leave-types/:id` now has something to count: a type somebody
  /// holds a balance in can no longer be deleted freely.
  balances EmployeeLeaveBalance[]

  /// The requests filed against this kind of leave.
  ///
  /// The second relation into `leave_types`, and the one that finally gives
  /// `requiresApproval` a reader: Feature 023 branches on it when a request is
  /// created, so a type that needs no approval produces an `APPROVED` request
  /// and deducts the days straight away.
  requests LeaveRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_types")
}

/// One employee's request to be away from work, over one span of dates, of one
/// kind of leave.
///
/// The first table in this schema that is neither configuration nor a standing
/// grant: it records something that *happened* — somebody asked, and somebody
/// answered. Everything before it describes how the company works or what each
/// person holds; this describes an event, which is why it is the only table with
/// a lifecycle column and the only one that writes to another table
/// (`employee_leave_balances.used_days`) as a consequence of its own writes.
///
/// **`requestedWorkingDays` is not a column, and must never become one.** It is
/// computed on every read from the work schedule, the public holidays and the
/// span — see `WorkingDaysService`. Storing it would freeze an answer that
/// depends on three tables the company keeps editing: correcting a holiday HR
/// entered on the wrong date would leave every request that spanned it holding a
/// day count nothing in the database agrees with, and no reader could tell which
/// of the two was right. The same argument `EmployeeLeaveBalance.remainingDays`
/// rests on, applied to a value with three inputs instead of three columns.
///
/// The days a request actually consumed *are* recorded, but as
/// `employee_leave_balances.used_days` rather than here: that is the ledger, and
/// a request is the document that moved it.
model LeaveRequest {
  id String @id @default(cuid())

  /// The person who will be away. Never changes after creation — a request
  /// filed by the wrong person is deleted while it is still `PENDING`, not
  /// reassigned, because reassigning it would move consumed days between two
  /// people's balances with no record that it happened.
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  /// The span requested, both ends inclusive — the same convention
  /// [PublicHoliday] uses, and for the same reason: a one-day absence stores the
  /// same date twice rather than leaving an end null, so "which days is this
  /// person away" never has a special case.
  ///
  /// These are calendar dates, not instants. A client posts `2026-09-07` and the
  /// column holds UTC midnight; every comparison in the application is made in
  /// UTC so the answer cannot depend on where the server is deployed.
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  /// Why the person is asking. Nullable, because "no reason given" is a real
  /// answer rather than a missing one: leave of a type that requires no approval
  /// is notified rather than requested, and demanding an explanation for a
  /// medical absence would put a diagnosis in a column read by every screen that
  /// lists requests.
  reason String?

  /// Where the request stands. Defaulted to `PENDING`, which is what a request
  /// is the instant it is filed; a type that needs no approval is written
  /// straight to `APPROVED` by the service, in the same statement.
  status LeaveRequestStatus @default(PENDING)

  /// Who decided, and when.
  ///
  /// **Two columns rather than one, and both nullable.** They are separate
  /// because they answer different questions and can be absent for different
  /// reasons: a request approved automatically — `LeaveType.requiresApproval =
  /// false` — has a `processedAt`, because the decision happened at a moment,
  /// but no `processedById`, because no person made it. Folding them into one
  /// column, or deriving either from `status` and `updatedAt`, would lose that
  /// distinction: `updatedAt` moves whenever any column does, so it cannot say
  /// when the decision was taken, and `status` alone cannot tell an automatic
  /// approval from a human one.
  ///
  /// `processedById` is an employee rather than a user, so the decision can be
  /// rendered as a name beside the request without a second join through
  /// `users`. It is `SetNull` on delete, unlike every other foreign key here:
  /// the fact that a decision was made survives the decider leaving the company,
  /// and `processedAt` keeps saying when it happened.
  processedById String?   @map("processed_by_id")
  processedBy   Employee? @relation("LeaveRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime? @map("processed_at")

  /// Why the decision went the way it did. Required by the API for `REJECTED`
  /// and `CANCELLED` and refused for `APPROVED`, but nullable in the column: an
  /// approval carries no explanation, and the automatic approvals have nobody to
  /// write one.
  decisionReason String? @map("decision_reason")

  /// Who covers the work. At least one, enforced by the API rather than by the
  /// schema — a column cannot require a row in another table to exist.
  replacements LeaveRequestReplacement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The three reads this table is built for, in the order they run hottest.
  ///
  /// Unlike the configuration tables of Features 016–021 — tens of rows, left
  /// unindexed on purpose — this one gains rows forever and is queried by
  /// employee on every `/me` request and by overlap on every write.
  ///
  /// `[employeeId, status]` serves both: listing one person's requests, and the
  /// overlap check that asks whether *this* person already has an `APPROVED`
  /// request touching the span. The composite leads with the selective column.
  @@index([employeeId, status])
  @@index([leaveTypeId])
  /// The HR list defaults to the current year and orders by date, both of which
  /// are ranges over this column.
  @@index([startDate])
  @@map("leave_requests")
}

/// One person named as cover for one leave request.
///
/// A table rather than an array column on [LeaveRequest], for the reason
/// [TimesheetApprovalEmail] is one — but here the argument is stronger, because
/// each entry is a *foreign key*: an array of ids would be a relation the
/// database could not enforce, so a replacement could name an employee who had
/// since been deleted and nothing would notice.
///
/// The primary key is the pair, which states the rule directly: a person may
/// cover a request once. Listing somebody twice is not a stronger nomination,
/// and without the constraint it would silently double every count taken over
/// this table.
///
/// There is no `id` and no `updatedAt`. Nothing about a nomination is editable —
/// changing who covers a request is removing one row and adding another, which
/// is what the API does when a `PENDING` request is patched — so the pair is the
/// whole identity and a surrogate key would only add a second way to name it.
model LeaveRequestReplacement {
  leaveRequestId String       @map("leave_request_id")
  /// `Cascade`, and the only cascade in this schema. A nomination is part of the
  /// request rather than a fact of its own: it says nothing once the request it
  /// belongs to is gone, so deleting a `PENDING` request takes its replacements
  /// with it. Every other foreign key here is `RESTRICT`, because everything
  /// else they point at outlives them.
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  /// `RESTRICT`, like every other reference to a person: an employee who is
  /// covering somebody's leave cannot be deleted out from under the request.
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@id([leaveRequestId, employeeId])
  /// The primary key leads with `leave_request_id`, so "which requests is this
  /// person covering" — the question the replacement-availability check asks on
  /// every write — cannot use it.
  @@index([employeeId])
  @@map("leave_request_replacements")
}

/// How much leave one employee has, of one kind, in one year.
///
/// The row HR creates by hand. Nothing here is derived from a contract, a
/// seniority level or a hire date, and **nothing is created automatically** —
/// adding an employee grants them nothing until somebody allocates it. That is
/// deliberate: entitlement is negotiated, and a number the system invented would
/// be indistinguishable from a number somebody agreed to.
///
/// **`remainingDays` is not a column, and must never become one.** It is
/// `allocatedDays + carriedOverDays - usedDays`, computed by the API on the way
/// out. Storing it would give the same fact two homes, and the day an `UPDATE`
/// touched one and not the other, the database would hold a balance that
/// contradicts its own parts. The three stored numbers are the single source of
/// truth; the fourth is a view of them.
///
/// The four are separate columns rather than one running total because they
/// answer different questions and are written by different hands: HR sets
/// `allocatedDays` and `carriedOverDays`, the Leave Requests feature moves
/// `usedDays`, and Feature 024's year-end generation writes `expiredDays`. A
/// single total would lose which of the four changed, and with it any way to
/// audit a balance that looks wrong — or to tell days somebody took from days
/// somebody forfeited.
model EmployeeLeaveBalance {
  id String @id @default(cuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  /// The calendar year the grant belongs to — 2026, not a date range. Leave is
  /// budgeted by the year everywhere this company operates, and a year is what
  /// the unique constraint needs to make "one balance per person per type per
  /// year" statable.
  year Int

  /// Days granted for this year by HR. Required and not defaulted: a balance
  /// exists because somebody decided a number, and `0` is a decision that has to
  /// be typed rather than one the schema makes on their behalf.
  allocatedDays Int @map("allocated_days")

  /// Days brought forward from earlier years. Defaulted to `0`, which is the
  /// answer for a first year and for a company that carries nothing over.
  ///
  /// Kept apart from `allocatedDays` because the two expire differently and are
  /// consumed in a different order — carried-over days first, oldest year first,
  /// as the Leave Requests feature will implement. Added together at entry, that
  /// ordering could never be applied.
  carriedOverDays Int @default(0) @map("carried_over_days")

  /// Days already consumed by approved leave. Defaulted to `0`.
  ///
  /// Maintained by hand in this feature and by the Leave Requests feature later,
  /// which is why it is a plain column rather than a count of request rows: the
  /// requests do not exist yet, and a balance opened with days already taken —
  /// an employee joining mid-year from another system — has to be expressible.
  usedDays Int @default(0) @map("used_days")

  /// Days written off at a year-end because the leave type's carry-over policy
  /// did not let them survive. Defaulted to `0`.
  ///
  /// **This column is what makes a carry-over cap mean anything.** Balances are
  /// consumed oldest year first and `findAvailable` reads every year up to the
  /// one being requested, so a remainder left in a closed year is *already*
  /// spendable in the next — carrying nothing forward is the system's natural
  /// behaviour, and it has no ceiling. Expiring the surplus in place is
  /// therefore the operation, and copying the survivors into the new year's
  /// [carriedOverDays] would count the same days twice.
  ///
  /// Kept apart from `usedDays` because the two are different facts: `usedDays`
  /// is leave somebody took, and this is leave somebody lost. Folded together,
  /// no report could tell an employee who used their allowance from one who
  /// forfeited it, and the year-end job would look like it had approved
  /// absences nobody requested.
  ///
  /// Written by Feature 024's generation and by `PATCH` for corrections; never
  /// by an approval.
  expiredDays Int @default(0) @map("expired_days")

  /// Free-text HR note: why the allocation is what it is. Optional, and read by
  /// nothing — it is for the person who opens this screen next year and wonders.
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One balance per employee, per leave type, per year — the rule the feature
  /// is built on, stated where it cannot be bypassed. `EmployeeLeaveBalanceService`
  /// checks it first to produce a `409` naming the three values, but this index
  /// is what closes the race between that check and the insert.
  @@unique([employeeId, leaveTypeId, year])
  /// `?leaveTypeId=` and `?year=` are the two filters the unique index above
  /// cannot serve: it leads with `employee_id`, so neither of the others can use
  /// it on its own. Unlike the configuration tables — which hold tens of rows
  /// and are deliberately left unindexed — this one grows by every employee ×
  /// every leave type × every year, forever, so the scan it would otherwise do
  /// gets steadily more expensive.
  @@index([leaveTypeId])
  @@index([year])
  @@map("employee_leave_balances")
}

/// An address notified when leave activity needs attention.
///
/// A table rather than an array column, for the reason [TimesheetApprovalEmail]
/// is one: each address is addressable on its own, so
/// `DELETE /leave-notification-emails/:id` removes one without rewriting the
/// rest, and `email` gets a unique index that an array could not have.
///
/// Unlike [TimesheetApprovalEmail] it carries no foreign key to anything. There
/// is no configuration row for it to hang off — the list *is* the
/// configuration, maintained as its own resource, and `PATCH` corrects a typo
/// in an address rather than deleting and re-adding it.
model LeaveNotificationEmail {
  id String @id @default(cuid())

  email String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_notification_emails")
}

/// An address notified when a timesheet needs approval.
///
/// A table rather than an array column on `WorkSchedule`, because each address
/// is addressable on its own: `DELETE /work-schedule/emails/:id` removes one
/// without rewriting the rest, and `email` gets a unique index that an array
/// could not have.
model TimesheetApprovalEmail {
  id String @id @default(cuid())

  /// Unique across the table, not merely within one schedule. There is exactly
  /// one schedule, so the two are the same set today — and stating it on the
  /// column is what makes the duplicate check a database guarantee rather than
  /// a race between a read and a write.
  email String @unique

  workScheduleId String       @map("work_schedule_id")
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("timesheet_approval_emails")
}

/// One message, in one of the two notification workspaces.
///
/// **This table stores and serves notifications. It does not produce them.**
/// Nothing in this schema writes a row here as a consequence of anything else:
/// approving leave, submitting a timesheet and finishing an import all leave it
/// untouched today. Deciding *when* a notification is born, and delivering it by
/// email or over a socket, is the Notification Delivery Engine — a later feature
/// — and separating the two is what lets this one be read, filtered and paged
/// without anything having to be scheduled, queued or sent. See the feature
/// document for the whole argument.
///
/// **Addressing lives in three columns, and only two shapes ever fill them.**
/// [recipientType] says which: `USER` sets `recipient_user_id` and leaves
/// `recipient_role` null, `ROLE` does the reverse, and the two broadcasts leave
/// both null. `NotificationService` enforces that, together with the rule that
/// only four of the eight workspace/recipient pairings are legal. Neither is a
/// CHECK constraint — the pairing rule and the null rule are one rule, stated
/// once in the service, rather than half of it duplicated where nobody reading
/// the other half would see it.
///
/// **`recipient_role` is a [UserRole], not a notification-specific enum**, and
/// that is deliberate. The three administrative roles already have stored
/// spellings — `superadmin`, `admin`, `hr` — and a second vocabulary saying
/// `super_admin` would mean every query joining a notification to the person
/// reading it had to translate between them, forever. The column's type
/// therefore also admits `USER`, which is not a legal value here; the service
/// refuses it, and `ADMINISTRATIVE_ROLES` in
/// `src/common/constants/role.constants.ts` is the one list of the three that
/// are legal.
model Notification {
  id String @id @default(cuid())

  /// Which inbox this belongs to. Not defaulted: a notification is written for
  /// one audience or the other, and guessing which would file back-office
  /// messages in employees' personal lists.
  workspace NotificationWorkspace

  recipientType NotificationRecipientType @map("recipient_type")

  /// The one account addressed, for `USER` notifications; null for every other
  /// recipient type.
  ///
  /// `Cascade` on delete, and the second cascade in this schema after
  /// `leave_request_replacements`. The argument is the same: a notification
  /// addressed to one person says nothing once that person's account is gone —
  /// nobody can read it and no list will ever return it — so keeping it would
  /// only make an account undeletable for the sake of messages nobody can see.
  /// Every reference to a *person* elsewhere is `RESTRICT`, because those record
  /// something that happened; this records something somebody was told.
  recipientUserId String? @map("recipient_user_id")
  recipientUser   User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  /// The one administrative role addressed, for `ROLE` notifications; null for
  /// every other recipient type. Only `SUPERADMIN`, `ADMIN` and `HR` are legal —
  /// see the note on this model for why the column's type is wider than the rule.
  recipientRole UserRole? @map("recipient_role")

  /// The one-line heading. Bounded at 150 characters by the API rather than by
  /// the column, like every other free text here: 150 is a rule about what fits
  /// on a screen, not a format the way `VarChar(7)` is for a colour.
  title String

  /// The body. Plain text, bounded at 5000 by the API. No markup is rendered and
  /// none is stripped — a client displays this as text, which is what keeps a
  /// message somebody typed from becoming markup somebody injected.
  message String

  /// Where the notification came from, what it looks like, and how loudly it
  /// asks. All three are defaulted, so a caller states only what departs from
  /// "an ordinary informational notice of normal importance" — the same call
  /// `Project.projectStatus` and `projectPriority` make, and for the same reason:
  /// an unstated priority is *normal*, not *unknown*.
  category NotificationCategory @default(GENERAL)
  type     NotificationType     @default(INFO)
  priority NotificationPriority @default(MEDIUM)

  /// Whether it has been read, and when.
  ///
  /// **One flag for the whole row, which is exactly right for a notification
  /// addressed to one person and a known limitation for a broadcast.** An
  /// `ALL_USERS` announcement is a single row read by everybody, so the first
  /// person to open it marks it read for all of them — and `DELETE
  /// /notifications/:id` removes it for all of them too. Correcting that needs a
  /// per-user `notification_reads` table, which is deferred rather than
  /// forgotten; the feature document states the trade-off and the migration path.
  ///
  /// Two columns rather than one, for the reason `leave_requests` keeps
  /// `processed_at` beside `status`: `updated_at` moves whenever any column does,
  /// so it cannot say when the notification was read. `read_at` is set when the
  /// flag is raised and is null while it is down; the two are written together
  /// and never independently.
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The two list queries this table exists to serve, plus their ordering.
  ///
  /// Unlike the configuration tables of Features 016–021 — tens of rows, left
  /// unindexed on purpose — this one gains a row for every event the delivery
  /// engine will ever announce, to every person it announces to, and never
  /// shrinks. Both lists are `WHERE workspace = … AND (addressed to me OR
  /// broadcast) ORDER BY created_at DESC`, so each index carries `created_at`
  /// last: PostgreSQL can then satisfy the filter and the sort from one scan
  /// instead of sorting the matches afterwards.
  ///
  /// `[recipientUserId, createdAt]` is the personal list's directly-addressed
  /// half, `[recipientRole, createdAt]` the administrative list's, and
  /// `[workspace, recipientType, createdAt]` covers both broadcasts and the
  /// workspace scope every query starts from.
  @@index([recipientUserId, createdAt])
  @@index([recipientRole, createdAt])
  @@index([workspace, recipientType, createdAt])
  @@map("notifications")
}

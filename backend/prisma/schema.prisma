// Prisma schema for the CRM TimeSheet backend.
// Docs: https://pris.ly/d/prisma-schema

// `prisma-client` replaces the deprecated `prisma-client-js`: it emits plain
// TypeScript instead of a package inside node_modules, so `output` is required.
// The target sits under `src/` on purpose — tsc then compiles the client into
// `dist/` along with everything else, and the build output stays `dist/main.js`.
// The directory is gitignored; it is rebuilt by `prisma generate`.
// `moduleFormat` is stated rather than inferred to match tsconfig's "commonjs".
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// As of Prisma 7 the connection URL no longer belongs here. Migrate and Studio
// read it from `prisma.config.ts`; the application passes it to the driver
// adapter in `src/prisma/prisma.service.ts`. Both resolve DATABASE_URL.
// See https://www.prisma.io/docs/guides/upgrade-prisma-orm/v7
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// How this schema stores time — two kinds of column, and they are not the same
// ---------------------------------------------------------------------------
//
// Introduced by Feature 031, which found the distinction the hard way while
// building reports. Every `DateTime` in this file is deliberately one or the
// other, and the choice is visible in whether it carries `@db.Timestamptz(3)`.
//
// 1. AN INSTANT — a moment that happened.  `@db.Timestamptz(3)`
//
//    `created_at`, `updated_at`, `submitted_at`, `reviewed_at`, `processed_at`,
//    `read_at`, `sent_at`, `scheduled_at`, `expires_at`, `joined_at`, `left_at`.
//
//    Which calendar day one of these falls on genuinely depends on where you are
//    standing: 22:30 UTC is already tomorrow in Bucharest. `timestamptz` stores
//    the instant (as UTC, internally) and lets PostgreSQL render it in whatever
//    zone is asked for, so the column cannot be misread.
//
//    It is `timestamptz` rather than plain `timestamp` for one concrete reason:
//    `DEFAULT CURRENT_TIMESTAMP` written into a `timestamp` column is cast using
//    the *session* time zone. That is correct today only because the session is
//    UTC — and the day somebody sets the container's zone to Europe/Bucharest,
//    new rows would silently start recording local time beside older rows in
//    UTC, mixed, with nothing to tell them apart. `timestamptz` removes the
//    question entirely.
//
// 2. A CALENDAR DATE — a day, with no time in it.  plain `timestamp`
//
//    `hire_date`, `termination_date`, `start_date`, `end_date` (projects,
//    holidays, leave requests) and `timesheet_entries.date`.
//
//    A client posts `2026-09-07` and the column holds UTC midnight; the time of
//    day is padding, not data. These MUST NOT become `timestamptz`: rendering
//    `2026-09-07T00:00Z` in a zone behind Greenwich yields the 6th, which would
//    move somebody's leave, a public holiday and a day of logged hours one day
//    earlier — silently, and everywhere at once.
//
//    They are read with UTC accessors throughout the application
//    (`toDateKey`, `weekdayOf`), never through a zone. See
//    `src/common/utils/date.util.ts`, which states both halves of the rule.
//
// When adding a `DateTime`, decide which of the two it is. If it is a moment,
// give it `@db.Timestamptz(3)`. If it is a day, leave it plain and say so in the
// field's own comment.

enum UserRole {
  SUPERADMIN @map("superadmin")
  ADMIN      @map("admin")
  HR         @map("hr")
  USER       @map("user")
}

enum EmployeeStatus {
  ACTIVE     @map("active")
  INACTIVE   @map("inactive")
  ON_LEAVE   @map("on_leave")
  SUSPENDED  @map("suspended")
  TERMINATED @map("terminated")
}

enum SeniorityLevel {
  INTERN @map("intern")
  JUNIOR @map("junior")
  MID    @map("mid")
  SENIOR @map("senior")
  LEAD   @map("lead")
}

/// Where a project is in its lifecycle. `ON_HOLD` is spelled with an
/// underscore, not a hyphen, to match `EmployeeStatus.ON_LEAVE` — the stored
/// value is what every query, export and enum literal has to repeat, so the two
/// vocabularies staying consistent matters more than the hyphen does.
enum ProjectStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  ON_HOLD   @map("on_hold")
  CANCELLED @map("cancelled")
}

enum ProjectPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

/// Whether a public holiday falls on the same calendar day every year, or has
/// to be stated for each year separately.
///
/// The values are stored lower-case like every other enum here, and the
/// distinction is not cosmetic: it decides which columns of `PublicHoliday`
/// carry meaning. For `FIXED` the year in `startDate` is disregarded and the
/// month and day are what recur; for `VARIABLE` the full dates are the fact,
/// and next year's occurrence is a different row.
enum HolidayType {
  FIXED    @map("fixed")
  VARIABLE @map("variable")
}

/// Where a leave request is in its lifecycle.
///
/// Four states and exactly one transition out of the first: `PENDING` may
/// become any of the other three, and none of those three becomes anything.
/// That is deliberate, and it is what makes "a decision never moves balances
/// back" a rule the state machine can keep rather than a promise the service
/// has to remember. See `LeaveRequestsService.decide` for the whole argument.
///
/// `CANCELLED` is a decision recorded against a request that was still waiting,
/// not an undo of an approval — an approved leave whose days have already been
/// deducted has no path back through this enum, because giving it one without
/// also releasing the days would leave the balance describing leave nobody took.
enum LeaveRequestStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
}

/// Which half of the working day a half-day absence covers.
///
/// **Two orthogonal fields rather than a new leave type**, and that is the whole
/// decision. Half a day is not a *kind* of leave — annual, medical and unpaid
/// leave can each be taken for half a day — so spelling it as a
/// `LeaveType` would multiply every existing type by two, double the balances
/// HR maintains, and leave `ANNUAL` and `ANNUAL_HALF_DAY` as two rows a report
/// would have to remember to add together. It is a *quantity* qualifying a
/// request of any type, which is what [LeaveRequest.isHalfDay] states.
///
/// Only two values, because a half day has two halves. Quarter days and
/// arbitrary hour ranges are deliberately not expressible: the Timesheets module
/// derives the hours from the work schedule — half of that day's configured
/// hours — and a vocabulary of fractions would be a small language invented
/// before anybody had asked for one.
///
/// Which half is stored rather than derived because it decides *which* hours are
/// left for work: somebody away for the morning fills the afternoon, and a
/// timesheet that could not say which would be describing a different day.
enum LeaveHalfDayPortion {
  FIRST_HALF  @map("first_half")
  SECOND_HALF @map("second_half")
}

/// A day of the week, declared Monday-first because that is the order the
/// business works in and the order a European calendar renders. The
/// declaration order is not cosmetic: it is what `WorkSchedule.workingDays` is
/// sorted by, so the stored array always reads as a week rather than as the
/// order somebody happened to tick the boxes in.
enum Weekday {
  MONDAY    @map("monday")
  TUESDAY   @map("tuesday")
  WEDNESDAY @map("wednesday")
  THURSDAY  @map("thursday")
  FRIDAY    @map("friday")
  SATURDAY  @map("saturday")
  SUNDAY    @map("sunday")
}

/// Which of the two notification workspaces a message belongs to.
///
/// Not a role and not a permission: it is the *inbox* the message is filed in.
/// `PERSONAL` is what an employee reads about themselves — their leave was
/// approved, their timesheet is due. `ADMINISTRATIVE` is the back-office inbox
/// the people who run the company share: a request was submitted, an import
/// finished, a synchronisation failed.
///
/// The distinction is stored rather than derived from [Notification.recipientType]
/// even though the two are correlated, because they answer different questions
/// and only one of them is a *scope*: the workspace is what a URL selects and
/// what a "mark everything read" acts over, while the recipient type says how
/// one row inside it is addressed. Deriving either from the other would make
/// every list query reason about the mapping instead of naming the column.
enum NotificationWorkspace {
  PERSONAL       @map("personal")
  ADMINISTRATIVE @map("administrative")
}

/// How a notification names who it is for.
///
/// Four values, and exactly four pairings with [NotificationWorkspace] are
/// legal — `PERSONAL`+`USER`, `PERSONAL`+`ALL_USERS`,
/// `ADMINISTRATIVE`+`ROLE`, `ADMINISTRATIVE`+`ADMINISTRATIVE_USERS`. The other
/// four combinations are refused by `NotificationService`, not by a CHECK
/// constraint: the rule also governs which of `recipient_user_id` and
/// `recipient_role` must be set and which must be null, so stating half of it
/// in the schema would leave the readable half in the application anyway.
///
/// `ALL_USERS` and `ADMINISTRATIVE_USERS` are *broadcasts* — one row read by
/// many people — and both carry a null recipient. See [Notification.isRead] for
/// what that costs.
enum NotificationRecipientType {
  USER                 @map("user")
  ROLE                 @map("role")
  ALL_USERS            @map("all_users")
  ADMINISTRATIVE_USERS @map("administrative_users")
}

/// What the notification is *about* — the part of the system it came from.
///
/// A closed vocabulary rather than free text, because it is what a client
/// filters and groups by: "show me only leave notifications" has to be a query
/// parameter, not a substring search over a title somebody phrased.
///
/// Deliberately separate from [NotificationType], which says how *urgent* it
/// looks rather than where it came from. A rejected leave request is
/// `LEAVE`+`ERROR`; a completed import is `SYSTEM`+`SUCCESS`. Folding the two
/// into one column would make "every leave notification" unanswerable.
enum NotificationCategory {
  GENERAL     @map("general")
  SYSTEM      @map("system")
  TIMESHEET   @map("timesheet")
  LEAVE       @map("leave")
  REMINDER    @map("reminder")
  MAINTENANCE @map("maintenance")
}

/// How the notification is drawn — the severity a client renders it with.
///
/// Presentation rather than routing: it decides the colour and the icon, and
/// nothing in the application branches on it.
enum NotificationType {
  INFO    @map("info")
  SUCCESS @map("success")
  WARNING @map("warning")
  ERROR   @map("error")
}

/// How much the notification wants attention.
///
/// Declared low-to-high on purpose, and the order is not cosmetic: PostgreSQL
/// sorts an enum by its declaration order, so `?sortBy=priority&sortOrder=desc`
/// puts `HIGH` first because of this list. Spelled the same way and in the same
/// direction as `ProjectPriority`, so the two vocabularies cannot drift into
/// sorting opposite ways.
enum NotificationPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

/// Where a manual notification campaign is in its lifecycle.
///
/// Four states, and only three of them are reachable through this API.
/// `DRAFT` and `SCHEDULED` are *derived* from whether the campaign carries a
/// `scheduled_at` — one fact, stated in one column, so the two can never
/// contradict each other — and `CANCELLED` is the one value a client may write
/// directly. `SENT` is written by the Notification Delivery Engine and by
/// nothing else: it is the record that the engine ran, and a client that could
/// set it would be claiming an announcement had gone out when nothing had.
///
/// `SENT` and `CANCELLED` are terminal. A `SENT` campaign can be neither edited
/// nor deleted — its notifications are already in people's inboxes, so editing
/// it would leave the stored announcement disagreeing with what was actually
/// delivered — and a `CANCELLED` one can no longer be edited, though it may
/// still be deleted.
enum NotificationCampaignStatus {
  DRAFT     @map("draft")
  SCHEDULED @map("scheduled")
  SENT      @map("sent")
  CANCELLED @map("cancelled")
}

/// How a campaign names who it is for.
///
/// Deliberately **not** [NotificationRecipientType], although the two look
/// alike. That enum addresses a `users` account or a `UserRole`; this one
/// addresses an `employees` row, which is a different table and a different
/// question — a campaign is announced to the people who work here, and the
/// screen that composes one picks names from the employee directory. Sharing an
/// enum between the two would mean `USER` sometimes meant an account and
/// sometimes a person.
///
/// `ALL_EMPLOYEES` stores **one** row with a null `employee_id`, never one row
/// per employee. See [NotificationRecipient].
enum CampaignRecipientType {
  EMPLOYEE      @map("employee")
  ALL_EMPLOYEES @map("all_employees")
}

/// The part of the application a permission is about — the *rows* of the
/// permission matrix.
///
/// A closed vocabulary rather than free text, because it is half of a
/// permission's identity: `Permission.key` is `RESOURCE.ACTION`, and a resource
/// somebody typed would produce a key nothing could resolve. It is also what the
/// catalog is filtered and grouped by, which a string column could not guarantee.
///
/// Twelve values, and they name *screens* rather than tables. `LEAVES` and
/// `LEAVE_REQUESTS` are two of them although both are leave: one is the
/// configuration HR maintains — the kinds of leave, the allocations — and the
/// other is the requests employees file against it, and no useful permission set
/// grants both together. `NOTIFICATION_CONFIG` is the reminder rules and the
/// campaigns of Feature 027, not the notification centre of Feature 026: reading
/// your own inbox is not a permission anybody is denied.
///
/// `DEPARTMENTS` is the organisational units of Feature 007 — the departments
/// employees belong to — and is deliberately not called `TEAMS`: there is no
/// team in this system, and naming a permission after a screen that does not
/// exist would leave an administrator granting something they could not find.
/// Project *rosters* are not a resource of their own either; a membership is
/// part of the project it is on, so it lives under `PROJECTS`.
///
/// Two values name screens this backend has not built yet — `TIMESHEET` and
/// `REPORTS`. They are in the catalog anyway, because a permission matrix is the
/// vocabulary an administrator configures *before* the feature ships, and adding
/// the value later would mean every already-configured user silently lacking it.
enum PermissionResource {
  DASHBOARD           @map("dashboard")
  TIMESHEET           @map("timesheet")
  EMPLOYEES           @map("employees")
  LEAVE_REQUESTS      @map("leave_requests")
  REPORTS             @map("reports")
  PROJECTS            @map("projects")
  LEAVES              @map("leaves")
  WORK_SCHEDULE       @map("work_schedule")
  PUBLIC_HOLIDAYS     @map("public_holidays")
  DEPARTMENTS         @map("departments")
  NOTIFICATION_CONFIG @map("notification_config")
  PERMISSIONS         @map("permissions")
}

/// What may be done to a resource — the *columns* of the permission matrix.
///
/// `PAGE_ACCESS` and `VIEW` are deliberately two values rather than one. Reaching
/// a screen and reading the records on it are different grants: a team lead may
/// open the employees page to find a colleague's extension without being allowed
/// to read the directory, and an integration may read records with no screen at
/// all. Folding them together would make the narrower of the two unstatable.
///
/// `CONFIGURE` is likewise not `EDIT`. Editing changes a record; configuring
/// changes the *rules* records are judged by — the carry-over policy of a leave
/// type, the company's working hours, which preset a user is put on. The people
/// trusted with the first are routinely not trusted with the second.
///
/// **Not every action applies to every resource**, and the catalog holds only the
/// pairs that mean something: `DASHBOARD` has nothing to create, `WORK_SCHEDULE`
/// is a single row with nothing to delete. See [Permission].
enum PermissionAction {
  PAGE_ACCESS @map("page_access")
  VIEW        @map("view")
  CREATE      @map("create")
  EDIT        @map("edit")
  DELETE      @map("delete")
  APPROVE     @map("approve")
  CONFIGURE   @map("configure")
}

/// Which way a per-user override departs from the role baseline.
///
/// Two values and no third, because an override that *agrees* with the baseline
/// is not a third kind of override — it is the absence of one. See
/// [UserPermissionOverride] for why storing it would be storing a fact the
/// baseline already states.
enum PermissionEffect {
  GRANT  @map("grant")
  REVOKE @map("revoke")
}

/// Where a monthly timesheet is in its lifecycle.
///
/// Four states and three transitions: `DRAFT → SUBMITTED`, `SUBMITTED →
/// APPROVED`, `SUBMITTED → REJECTED`, and the one loop back — `REJECTED →
/// SUBMITTED`. Nothing leaves `APPROVED`, ever.
///
/// `DRAFT` is private to the person filling it in: an administrator never sees
/// one, because a half-finished month is not a claim about anything yet.
/// `SUBMITTED` is locked to the owner and waiting for a decision. `REJECTED` is a
/// state of its own rather than a return to `DRAFT`, and that is deliberate — it
/// carries the reason it was refused, it is what a list renders in red, and
/// collapsing it into `DRAFT` would erase the fact that somebody looked at the
/// month and said no.
///
/// `APPROVED` is terminal and immutable. It is the record of what the company
/// agreed somebody worked, and re-opening it would leave an approved month
/// disagreeing with the approval — the same argument [LeaveRequestStatus] makes
/// for a decided request, and [NotificationCampaignStatus] for a sent campaign.
enum TimesheetStatus {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
}

/// What one line of a timesheet accounts for.
///
/// Three values, and only the first is something the employee chooses. `WORK` is
/// time booked against a project; `LEAVE` and `HOLIDAY` are hours the company
/// already knows about — an approved absence and a day the office is closed —
/// which the fill-in engine writes from the leave requests and the public
/// holidays. See [TimesheetEntry.type] for why the last two are not editable.
enum TimesheetEntryType {
  WORK    @map("work")
  LEAVE   @map("leave")
  HOLIDAY @map("holiday")
}

/// What happened to somebody's permissions — the vocabulary of the history tab.
///
/// The first three describe one permission each and are written by the diff:
/// an override appeared as a grant, appeared as a revocation, or was removed so
/// the role baseline applies again. The last two describe a *whole* operation and
/// are written once beside the per-permission rows, which is why they are the
/// only two that can carry a null `permission_id`.
///
/// `PRESET_APPLIED` and `RESET_TO_ROLE` are kept as separate values rather than
/// derived from `preset_id` being set or null. They are different acts —
/// "put this person on HR - View Only" and "give this person exactly what their
/// role gives" — and a reader of the history should not have to infer which from
/// the nullability of another column.
enum PermissionAuditAction {
  PERMISSION_GRANTED @map("permission_granted")
  PERMISSION_REVOKED @map("permission_revoked")
  OVERRIDE_CLEARED   @map("override_cleared")
  PRESET_APPLIED     @map("preset_applied")
  RESET_TO_ROLE      @map("reset_to_role")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String? @unique

  passwordHash String @map("password_hash")

  role     UserRole @default(USER)
  isActive Boolean  @default(true) @map("is_active")

  employee Employee?

  /// Notifications addressed to this account by name.
  ///
  /// Only the `USER` recipient type points here. A broadcast — `ALL_USERS` or
  /// `ADMINISTRATIVE_USERS` — and a role-addressed notification both leave
  /// `recipient_user_id` null, so this relation is the *directly addressed*
  /// subset rather than everything a person can see.
  notifications Notification[]

  /// Where this account's permissions depart from what its role grants.
  ///
  /// Only the exceptions, never the whole matrix — a user who holds exactly what
  /// their role gives has no rows here at all. See [UserPermissionOverride].
  permissionOverrides UserPermissionOverride[]

  /// Changes made to *this* account's permissions.
  ///
  /// Two relations to [PermissionAuditLog], which is why both carry an explicit
  /// name: without one Prisma cannot tell which foreign key each side belongs to.
  /// They are genuinely different facts — one is what was done to you, the other
  /// is what you did to somebody — and one account regularly appears in both, as
  /// an administrator who edits their colleagues' permissions and has their own
  /// edited by the super-admin. The same shape `Employee.leaveRequests` and
  /// `processedLeaveRequests` already use.
  permissionAuditEntries PermissionAuditLog[] @relation("PermissionAuditTarget")

  /// Changes this account made to other people's permissions.
  permissionChangesMade PermissionAuditLog[] @relation("PermissionAuditActor")

  /// The refresh tokens issued to this account — its live and spent sessions.
  ///
  /// Added by Feature 032, and the only place authentication touches this model:
  /// `email`, `passwordHash`, `role` and `isActive` were already here and are
  /// what logging in reads. See [RefreshToken].
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Employee {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  employeeCode String @unique @map("employee_code")

  firstName String @map("first_name")
  lastName  String @map("last_name")

  phone String?

  hireDate DateTime @map("hire_date")

  /// The last day the person worked here, or null while they still do.
  ///
  /// Added by Feature 030, which is the first thing in this application with a
  /// reason to know it: a timesheet entry is only acceptable inside
  /// `[hireDate, terminationDate ?? today]`, and without a date there is no way
  /// to say that the 1st to the 12th of somebody's final month are fillable and
  /// the 13th onwards are not.
  ///
  /// **A separate fact from `status = TERMINATED`**, not a duplicate of it. The
  /// status says where the person stands *now* and is what every list filters on;
  /// this says *when* they left, which a status cannot carry. The two are not
  /// kept in step by the schema — a status is set by hand and this is entered
  /// beside it — because the honest failure of a derived column would be a
  /// termination date the application had invented, and Feature 020 already ends
  /// project memberships from the status transition rather than from a date.
  ///
  /// Nullable, and null is the ordinary case: an employee who works here has no
  /// termination date, and `hireDate` is the only end of the range that is always
  /// known.
  terminationDate DateTime? @map("termination_date")

  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])

  projectMemberships ProjectMember[]

  seniority SeniorityLevel

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  canReplaceOthers Boolean @default(false) @map("can_replace_others")

  status EmployeeStatus

  /// Leave granted to this person, one row per leave type per year.
  ///
  /// This replaces the `maxVacationDays` column Feature 010 put here. That
  /// column held one number for one unnamed kind of leave, with no year on it,
  /// so it could not say how many days somebody had in 2026 as opposed to 2027
  /// and could not say anything at all about medical or unpaid leave. The
  /// balances carry the year and the leave type, which is the grain HR actually
  /// grants in.
  leaveBalances EmployeeLeaveBalance[]

  /// Leave this person has asked for — the requests they own.
  leaveRequests LeaveRequest[]

  /// Leave requests this person decided on, as HR or an administrator.
  ///
  /// A second relation to the same table, which is why both ends carry an
  /// explicit name: without one Prisma cannot tell which foreign key each side
  /// belongs to. The two are genuinely different facts — `leaveRequests` is
  /// leave somebody asked for, this is leave somebody granted or refused — and
  /// a single relation could not express that one person may appear in both
  /// roles on different rows, which is exactly what happens when an HR manager
  /// books their own holiday.
  processedLeaveRequests LeaveRequest[] @relation("LeaveRequestProcessor")

  /// Requests naming this person as the one covering the work.
  leaveRequestReplacements LeaveRequestReplacement[]

  /// Manual notification campaigns this person composed.
  ///
  /// The author rather than an audience: a campaign records who wrote it, which
  /// is why the foreign key is `RESTRICT` like every other reference to a person
  /// that records something somebody *did*.
  notificationCampaigns NotificationCampaign[]
  /// Campaigns addressed to this person by name.
  ///
  /// Only the `EMPLOYEE` recipient type points here. An `ALL_EMPLOYEES` campaign
  /// stores one row with a null `employee_id`, so this relation is the
  /// *individually addressed* subset rather than every campaign a person will
  /// receive — the same distinction `User.notifications` draws.
  campaignRecipients NotificationRecipient[]

  /// The months this person has accounted for — their own timesheets.
  timesheets Timesheet[]

  /// The timesheets this person approved or rejected, as an administrator.
  ///
  /// A second relation to the same table, which is why both ends carry an
  /// explicit name — the shape `leaveRequests` and `processedLeaveRequests`
  /// already use, and for the same reason: one person routinely appears in both,
  /// as an administrator who reviews their colleagues' months and files their own.
  reviewedTimesheets Timesheet[] @relation("TimesheetReviewer")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("employees")
}

model Position {
  id   String @id @default(cuid())
  code String @unique

  name String @unique

  employees Employee[]

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("positions")
}

model Department {
  id   String @id @default(cuid())
  code String @unique

  name String @unique

  employees Employee[]

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("departments")
}

model Project {
  id String @id @default(cuid())

  code String @unique

  name String

  /// Customer the work is billed to. Required: an internal project names the
  /// company itself rather than leaving the column empty.
  clientName String @map("client_name")

  description String?

  /// Budgeted effort in whole hours. `0` means "not estimated yet", which is
  /// why the column has a default instead of being nullable.
  estimatedHours Int @default(0) @map("estimated_hours")

  /// UI accent, stored as `#RRGGBB`. Seven characters is exactly the format,
  /// so the length is part of the column rather than only an API rule.
  color String? @db.VarChar(7)

  /// Lifecycle state. Defaulted rather than required, so the column has an
  /// answer for the rows that existed before this feature and for a project
  /// created without an opinion about it.
  projectStatus ProjectStatus @default(ACTIVE) @map("project_status")

  /// Scheduling priority, defaulted to the middle of the scale for the same
  /// reason: an unstated priority is "normal", not "unknown".
  projectPriority ProjectPriority @default(MEDIUM) @map("project_priority")

  /// Hidden from normal listings without being deleted. A separate axis from
  /// `projectStatus`: a completed project and a cancelled one can both be
  /// archived, and the distinction between them survives the archiving.
  isArchived Boolean @default(false) @map("is_archived")

  memberships ProjectMember[]

  /// The hours booked against this project, one row per line of a timesheet.
  ///
  /// The relation that finally gives `estimated_hours` something to be compared
  /// with, though nothing in Feature 030 makes that comparison: it records what
  /// was worked, and reporting on it is a later feature.
  timesheetEntries TimesheetEntry[]

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("projects")
}

model ProjectMember {
  projectId  String
  employeeId String

  isProjectManager Boolean @default(false) @map("is_project_manager")

  project Project @relation(fields: [projectId], references: [id])

  employee Employee @relation(fields: [employeeId], references: [id])

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  @@id([projectId, employeeId])
  @@map("project_members")
}

/// The company's working schedule — one row, for the whole application.
///
/// Configuration rather than data: it describes how the company works, not
/// something that happened. The Timesheets module will read it to decide
/// whether an entry is acceptable; nothing here computes anything.
///
/// **Only one row may exist**, and that is enforced by the primary key rather
/// than by the service alone. `id` has a constant default, so an INSERT that
/// does not name an id lands on the same key as the existing configuration and
/// is rejected as a duplicate primary key instead of quietly becoming a second
/// one. The literal is `WORK_SCHEDULE_ID` in
/// `src/modules/work-schedule/work-schedule.constants.ts`; the two must stay in
/// step, which is why both sides say so.
model WorkSchedule {
  id String @id @default("work_schedule")

  /// Which weekdays are working days. A PostgreSQL array of the `Weekday` enum,
  /// so the column itself rejects a value that is not a day of the week — a
  /// `String[]` would have accepted `"Funday"`. Held in `Weekday` declaration
  /// order; duplicates are rejected by the DTO, since an array column cannot
  /// express that.
  ///
  /// **This column is the only statement about which days are worked, and
  /// nothing anywhere hard-codes a weekend.** A company that works Saturdays says
  /// so here, and a company that works Monday to Sunday inclusive says that here
  /// too — in both cases the Timesheets module lets those days be logged, because
  /// "not loggable" means "not in this array" rather than "Saturday or Sunday".
  /// A weekend rule of its own would contradict this configuration the moment
  /// somebody used it.
  workingDays Weekday[] @map("working_days")

  /// Which weekday a week begins on, for the purpose of a weekly total.
  ///
  /// Added by Feature 030, which is the first thing here that has to *group* days
  /// into weeks: a timesheet's hours are capped per day and per week, and a
  /// weekly cap is meaningless without saying where a week starts. It is
  /// deliberately configuration rather than a constant — this application is not
  /// deployed in one country, and the working week begins on Sunday in a great
  /// deal of the world and on Saturday in some of it. A Monday hard-coded in the
  /// grouping would split such a company's week across two buckets and let the
  /// weekly ceiling be exceeded by design.
  ///
  /// **Not derivable from [workingDays], which is why it is stored.** An array
  /// says which days are worked, not which of them the week turns over on: a
  /// company working Sunday to Thursday and one working Monday to Friday can hold
  /// overlapping arrays, and "the first working day" would call a Tuesday-to-
  /// Saturday week a week beginning on Tuesday. The two facts are independent and
  /// are stated independently.
  ///
  /// Defaulted to `MONDAY`, which is what the existing row means: `Weekday` is
  /// declared Monday-first because that is the order a European calendar renders,
  /// and the migration that adds this column must not silently re-group the weeks
  /// of a schedule already configured.
  weekStartsOn Weekday @default(MONDAY) @map("week_starts_on")

  /// `HH:mm`, 24-hour. Stored as text rather than as `time`, because the value
  /// is a wall-clock label — "the office opens at 09:00" — not an instant, and
  /// the `timestamp`-backed alternative would drag a date and a timezone along
  /// with it. `varchar(5)` is exactly the format's width, so the shape is part
  /// of the column and not only an API rule.
  workStartTime String @map("work_start_time") @db.VarChar(5)
  workEndTime   String @map("work_end_time") @db.VarChar(5)

  /// The one zone the application interprets calendar days in.
  ///
  /// **An IANA zone name — `Europe/Bucharest`, `UTC`, `America/New_York` — and
  /// never a numeric offset.** Stored as text because that is exactly what the
  /// value is: a zone *identifier*, not an amount of time. An offset is not the
  /// same fact; `+02:00` describes Bucharest for half the year and is wrong for
  /// the other half, because daylight saving moves it. The IANA name is the
  /// stable thing, and it is what carries the rules for when the offset changes.
  ///
  /// This is the companion piece to [workStartTime] and [workEndTime] above.
  /// Those are wall-clock labels precisely so they do not each drag a zone along
  /// with them; this column is the single zone they — and every day boundary in
  /// the application — are read in. Which instant belongs to which calendar day,
  /// where a day ends, which day a weekend rule is applied to and how a day-level
  /// report groups its rows are all one question, and it is answered here once.
  ///
  /// It is **company-wide, not per employee**. It belongs to the working
  /// schedule because the schedule already owns what a working day means; a
  /// per-person zone is a different and much larger feature, and this column
  /// deliberately does not open that door.
  ///
  /// **Changing it re-interprets days that have already happened.** Nothing
  /// stored moves — an entry recorded at a given instant stays at that instant —
  /// but the calendar day that instant falls on can change, so a timesheet or a
  /// report may group the same rows differently afterwards. Nothing is rewritten,
  /// recomputed or migrated when this value changes, which is the same stance
  /// taken everywhere else here: a configuration change does not silently edit
  /// facts already recorded. That makes this a rare administrative setting rather
  /// than a routine toggle, and Feature 016's document says so at length.
  ///
  /// Defaulted to `Europe/Bucharest`, which is what the existing configuration
  /// row has always meant in practice; the same literal is `DEFAULT_TIMEZONE` in
  /// `src/modules/work-schedule/work-schedule.constants.ts`, and the two move
  /// together for the reason `id` and `WORK_SCHEDULE_ID` do.
  timezone String @default("Europe/Bucharest") @map("timezone")

  /// Hour bounds, as `decimal(5,2)` — never `double`.
  ///
  /// Half hours (`0.5`) and quarter hours (`0.25`) are the granularity people
  /// actually book, and these are the numbers the Timesheets module will
  /// compare against and sum. Binary floating point cannot hold `0.1` exactly,
  /// so a column of totals would drift by fractions of a second per row and a
  /// `>=` comparison at the boundary would come out differently depending on
  /// how the value was reached. `decimal` is exact for both.
  ///
  /// `(5, 2)` allows up to `999.99` with two decimals: comfortably past the 168
  /// hours in a week, and it makes a third decimal a rejected value rather than
  /// a silently rounded one.
  minHoursPerEntry Decimal @map("min_hours_per_entry") @db.Decimal(5, 2)
  maxHoursPerEntry Decimal @map("max_hours_per_entry") @db.Decimal(5, 2)
  maxHoursPerDay   Decimal @map("max_hours_per_day") @db.Decimal(5, 2)

  standardHoursPerDay  Decimal @map("standard_hours_per_day") @db.Decimal(5, 2)
  standardHoursPerWeek Decimal @map("standard_hours_per_week") @db.Decimal(5, 2)

  /// Informational only. It is recorded so a payroll export, a report or a
  /// future policy can state the company's lunch break, and it is deliberately
  /// subtracted from nothing: hours are what an employee books, and quietly
  /// removing an hour from a day somebody logged would make the stored total
  /// disagree with what they entered.
  lunchBreakHours Decimal @map("lunch_break_hours") @db.Decimal(5, 2)

  approvalEmails TimesheetApprovalEmail[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("work_schedules")
}

/// A day the company does not work — a legal holiday, or one it grants itself.
///
/// Configuration rather than data, like [WorkSchedule]: it describes when the
/// company is closed, not something that happened. The Timesheets and Vacations
/// modules will read it; nothing here computes anything, and in particular no
/// date is derived — Easter is entered, not calculated.
///
/// **A holiday is never deleted to switch it off, and never edited in place to
/// repeal it.** A row is one *version* of a holiday, valid over a range of
/// years; repealing closes the range and reinstating opens a new row. That is
/// what lets `/calendar/2026` report 2026 as it actually was — see
/// `validFromYear`.
///
/// There is no unique constraint. `name` cannot be one — "Easter" is a
/// different row in every year — and the rule that actually applies to `FIXED`
/// holidays is "one per month and day *among versions whose years overlap*",
/// which no unique index can state. `PublicHolidayService` enforces both
/// duplicate rules.
model PublicHoliday {
  id String @id @default(cuid())

  name        String
  description String?

  type HolidayType

  /// A legal holiday the whole country observes (`true`), or one this company
  /// grants on its own (`false`). Defaulted to `true` because the set this
  /// table is created to hold is the national calendar; a company day off is
  /// the deliberate exception.
  isNational Boolean @default(true) @map("is_national")

  /// The years this version of the holiday applies to, both ends inclusive and
  /// both open-ended when null: `validFromYear` null means "as far back as this
  /// system knows", `validToYear` null means "still in force".
  ///
  /// They replace the `isActive` boolean this model started with, and the
  /// reason is the bug that boolean had rather than a preference. A flag
  /// carries no date, so switching a holiday off in 2029 also removed it from
  /// the 2026 calendar — a year the office really was closed. A range says
  /// *when* it stopped, so the past keeps its answer.
  ///
  /// Only meaningful for `FIXED` holidays, and rejected on `VARIABLE` ones: a
  /// variable holiday's row already *is* one year, named by `startDate`, so a
  /// range on it would be a second, contradictable statement of the same fact.
  ///
  /// They say nothing about the year inside `startDate`, which stays
  /// meaningless for a fixed holiday. A version valid from 2029 may perfectly
  /// well store `2025-06-01`; only the month and day are read.
  validFromYear Int? @map("valid_from_year")
  validToYear   Int? @map("valid_to_year")

  /// The span the holiday covers, both ends inclusive. A one-day holiday stores
  /// the same date twice rather than leaving `endDate` null: every consumer then
  /// reads one shape, and "which days are closed" never has a special case.
  ///
  /// For a `FIXED` holiday only the month and day are meaningful; the year is
  /// whatever year it was first entered for, and the recurrence rule ignores it.
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  /// Derived from `type` — `true` for `FIXED`, `false` for `VARIABLE` — and
  /// stored anyway, so a report or an export can state the fact without also
  /// having to know the rule. The API keeps the two in step; the `false`
  /// default is the database's answer for rows written outside it.
  isRecurring Boolean @default(false) @map("is_recurring")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("public_holidays")
}

/// A kind of leave an employee can take — annual, medical, unpaid, and so on.
///
/// Configuration rather than data, like [WorkSchedule] and [PublicHoliday]: it
/// describes what leave the company recognises, not that anybody took any. No
/// employee, balance or request refers to it yet; the modules that introduce
/// those will point at this table rather than repeating its vocabulary.
///
/// Both `code` and `label` are unique, and they are unique for different
/// reasons. `code` is the natural key an export, an integration or a URL quotes
/// (`ANNUAL`); `label` is what a person reads on a form ("Annual Leave"), and
/// two rows sharing one would be indistinguishable on every screen that lists
/// them. `LeaveTypesService` folds case before either check, since PostgreSQL's
/// unique indexes do not.
model LeaveType {
  id String @id @default(cuid())

  code  String @unique
  label String @unique

  /// The one-to-three character marker this kind of leave is drawn as in a
  /// report grid — `C`, `M`, `S`.
  ///
  /// Added by Feature 031. The collective attendance sheet and the leave
  /// calendar are grids of employees by days, where one cell is a few
  /// millimetres wide: a day of absence has room for a letter and nothing more,
  /// so the marker is what the report actually prints and the label is what its
  /// legend expands.
  ///
  /// **It is a column rather than a rule in the reporting module**, and that is
  /// the whole point of the field. Reporting must not decide that `MEDICAL` is
  /// drawn as `M` — a hard-coded list would leave every leave type added
  /// afterwards either invisible or colliding with an existing letter, and would
  /// put a statement about leave types inside a feature that only reads them. A
  /// company that adds `PATERNITY` gives it a marker on the leave-type screen and
  /// it appears on every report with no code change.
  ///
  /// **Unique**, so two kinds of leave can never print the same letter: a grid
  /// where `C` means two different things is a grid nobody can read, and the
  /// legend would list one marker twice. `LeaveTypesService` folds case before
  /// the check, as it already does for `code` and `label`.
  ///
  /// `varchar(3)` because the bound is the point: this is a glyph, not a name.
  /// Existing rows were backfilled from `code` — the first character, widened
  /// and then suffixed only where that collided — and are editable afterwards.
  reportMarker String @unique @map("report_marker") @db.VarChar(3)

  /// The *name* of an icon — `umbrella-beach`, `hospital`, `baby` — never the
  /// icon itself. A CSV export, a native app and a PDF report each need their
  /// own drawing of the same idea, and only the frontend knows which set it
  /// ships, so this column holds a key into that set rather than a picture.
  ///
  /// The API bounds the length (50) and requires it to be non-empty, and states
  /// nothing else about the spelling: icon sets disagree on one, and a pattern
  /// would reject whichever set the frontend actually uses.
  icon String

  /// UI accent, stored as `#RRGGBB`. Seven characters is exactly the format, so
  /// the length is part of the column rather than only an API rule — the same
  /// call `Project.color` makes.
  color String? @db.VarChar(7)

  description String?

  /// The number of days HR is *suggested* when it creates an employee's annual
  /// balance for this leave type.
  ///
  /// **Nothing is allocated by this column on its own.** It is a default, not an
  /// entitlement — Feature 024's generation seeds new balances from it, and HR
  /// may edit any of them afterwards: entitlement is per employee
  /// and per year — it depends on seniority, on the contract, on days carried
  /// over — and none of those facts live here. A balance table owned by that
  /// feature will hold the numbers that were actually granted, so changing this
  /// value never silently rewrites what somebody was already given.
  ///
  /// Nullable, because "no suggestion" is a real answer: medical leave is
  /// granted against a certificate rather than out of a pot, and `0` would claim
  /// an allocation of zero days instead.
  defaultAllocatedDays Int? @map("default_allocated_days")

  /// Whether days left over at the end of a year may still be taken in the next
  /// one.
  ///
  /// Defaulted to `false`, which is the conservative half of the pair: after the
  /// migration that adds this column, no type carries anything over until
  /// somebody says it does. Annual leave is the type this exists for; medical
  /// leave is granted against a certificate rather than out of a pot, so there is
  /// nothing to carry.
  ///
  /// **This column does not move days.** Balances are consumed oldest year
  /// first, so last year's remainder is already spendable — what Feature 024's
  /// generation writes off is the part that is *not* allowed to survive. See
  /// [EmployeeLeaveBalance.expiredDays].
  allowsCarryOver Boolean @default(false) @map("allows_carry_over")

  /// The most days that may survive one year-end, or `null` for no cap.
  ///
  /// Read only when [allowsCarryOver] is `true`; on a type that carries nothing
  /// over it would describe a limit on something that never happens. Kept
  /// nullable rather than defaulted to a number because "carries over, without a
  /// ceiling" is a real policy, and `0` would mean the opposite of it.
  maxCarryOverDays Int? @map("max_carry_over_days")

  /// Whether a request of this type has to be approved before it counts.
  /// Defaulted to `true` because approval is the norm — annual leave is agreed
  /// in advance — and the exception is deliberate: medical leave is notified,
  /// not requested. Read by the Leave Requests module; nothing here acts on it.
  requiresApproval Boolean @default(true) @map("requires_approval")

  /// Whether the days are paid. Defaulted to `true` for the same reason:
  /// unpaid leave is the exception that has to be stated.
  isPaid Boolean @default(true) @map("is_paid")

  /// Hidden from new requests without being deleted, so leave already recorded
  /// against a retired type keeps its meaning. A separate axis from `isPaid` and
  /// `requiresApproval`, which describe the type rather than its availability.
  isActive Boolean @default(true) @map("is_active")

  /// The per-employee, per-year grants of this kind of leave.
  ///
  /// The first relation into `leave_types`, and the reason Feature 021's note
  /// about `DELETE /leave-types/:id` now has something to count: a type somebody
  /// holds a balance in can no longer be deleted freely.
  balances EmployeeLeaveBalance[]

  /// The requests filed against this kind of leave.
  ///
  /// The second relation into `leave_types`, and the one that finally gives
  /// `requiresApproval` a reader: Feature 023 branches on it when a request is
  /// created, so a type that needs no approval produces an `APPROVED` request
  /// and deducts the days straight away.
  requests LeaveRequest[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("leave_types")
}

/// One employee's request to be away from work, over one span of dates, of one
/// kind of leave.
///
/// The first table in this schema that is neither configuration nor a standing
/// grant: it records something that *happened* — somebody asked, and somebody
/// answered. Everything before it describes how the company works or what each
/// person holds; this describes an event, which is why it is the only table with
/// a lifecycle column and the only one that writes to another table
/// (`employee_leave_balances.used_days`) as a consequence of its own writes.
///
/// **`requestedWorkingDays` is not a column, and must never become one.** It is
/// computed on every read from the work schedule, the public holidays and the
/// span — see `WorkingDaysService`. Storing it would freeze an answer that
/// depends on three tables the company keeps editing: correcting a holiday HR
/// entered on the wrong date would leave every request that spanned it holding a
/// day count nothing in the database agrees with, and no reader could tell which
/// of the two was right. The same argument `EmployeeLeaveBalance.remainingDays`
/// rests on, applied to a value with three inputs instead of three columns.
///
/// The days a request actually consumed *are* recorded, but as
/// `employee_leave_balances.used_days` rather than here: that is the ledger, and
/// a request is the document that moved it.
model LeaveRequest {
  id String @id @default(cuid())

  /// The person who will be away. Never changes after creation — a request
  /// filed by the wrong person is deleted while it is still `PENDING`, not
  /// reassigned, because reassigning it would move consumed days between two
  /// people's balances with no record that it happened.
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  /// The span requested, both ends inclusive — the same convention
  /// [PublicHoliday] uses, and for the same reason: a one-day absence stores the
  /// same date twice rather than leaving an end null, so "which days is this
  /// person away" never has a special case.
  ///
  /// These are calendar dates, not instants. A client posts `2026-09-07` and the
  /// column holds UTC midnight; every comparison in the application is made in
  /// UTC so the answer cannot depend on where the server is deployed.
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  /// Whether the absence covers half a working day rather than whole ones.
  ///
  /// **Added by Feature 030, and deliberately a flag on the request rather than a
  /// new [LeaveType].** Half a day is a quantity, not a kind of leave: annual,
  /// medical and unpaid leave can each be taken for half a day, so a
  /// `ANNUAL_HALF_DAY` type would double every type HR maintains, double the
  /// balances hanging off them, and leave every report having to remember that
  /// two rows are one thing. This column and [halfDayPortion] are orthogonal to
  /// `leave_type_id`, which is what lets any type be taken either way.
  ///
  /// Defaulted to `false`, so every request written before this column existed is
  /// what it always was: a whole-day absence.
  ///
  /// **How many hours half a day is, is not stated here.** The Timesheets module
  /// takes half of that day's configured hours from the work schedule — see
  /// [WorkSchedule.standardHoursPerDay] — so a company that moves to a seven-hour
  /// day gets three and a half rather than a hard-coded four.
  ///
  /// Nothing about the *balance* changes: a half day still consumes a whole day
  /// of entitlement, because `employee_leave_balances` is counted in whole days
  /// and giving it halves is a decision with its own migration. Feature 030
  /// records that limitation rather than quietly changing what a day means.
  isHalfDay Boolean @default(false) @map("is_half_day")

  /// Which half, on a half-day absence; null on every whole-day one.
  ///
  /// Required exactly when [isHalfDay] is true and refused otherwise, which the
  /// API enforces rather than a CHECK constraint — the rule is about two columns
  /// at once and is judged against the state a `PATCH` would leave behind, which
  /// is the same reason the notification addressing rules live in a service.
  ///
  /// Stored rather than assumed, because it decides which hours are left for
  /// work: somebody away for the morning fills the afternoon, and a timesheet
  /// that could not say which half would be describing a different day.
  halfDayPortion LeaveHalfDayPortion? @map("half_day_portion")

  /// Why the person is asking. Nullable, because "no reason given" is a real
  /// answer rather than a missing one: leave of a type that requires no approval
  /// is notified rather than requested, and demanding an explanation for a
  /// medical absence would put a diagnosis in a column read by every screen that
  /// lists requests.
  reason String?

  /// Where the request stands. Defaulted to `PENDING`, which is what a request
  /// is the instant it is filed; a type that needs no approval is written
  /// straight to `APPROVED` by the service, in the same statement.
  status LeaveRequestStatus @default(PENDING)

  /// Who decided, and when.
  ///
  /// **Two columns rather than one, and both nullable.** They are separate
  /// because they answer different questions and can be absent for different
  /// reasons: a request approved automatically — `LeaveType.requiresApproval =
  /// false` — has a `processedAt`, because the decision happened at a moment,
  /// but no `processedById`, because no person made it. Folding them into one
  /// column, or deriving either from `status` and `updatedAt`, would lose that
  /// distinction: `updatedAt` moves whenever any column does, so it cannot say
  /// when the decision was taken, and `status` alone cannot tell an automatic
  /// approval from a human one.
  ///
  /// `processedById` is an employee rather than a user, so the decision can be
  /// rendered as a name beside the request without a second join through
  /// `users`. It is `SetNull` on delete, unlike every other foreign key here:
  /// the fact that a decision was made survives the decider leaving the company,
  /// and `processedAt` keeps saying when it happened.
  processedById String?   @map("processed_by_id")
  processedBy   Employee? @relation("LeaveRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)

  /// Why the decision went the way it did. Required by the API for `REJECTED`
  /// and `CANCELLED` and refused for `APPROVED`, but nullable in the column: an
  /// approval carries no explanation, and the automatic approvals have nobody to
  /// write one.
  decisionReason String? @map("decision_reason")

  /// Who covers the work. At least one, enforced by the API rather than by the
  /// schema — a column cannot require a row in another table to exist.
  replacements LeaveRequestReplacement[]

  /// The timesheet days this absence accounts for.
  ///
  /// One entry per day the leave covers, written by the Timesheets module's
  /// fill-in engine so a `LEAVE` line can be traced back to the request that
  /// justifies it. Empty for a request nobody has yet filled a timesheet around.
  timesheetEntries TimesheetEntry[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The three reads this table is built for, in the order they run hottest.
  ///
  /// Unlike the configuration tables of Features 016–021 — tens of rows, left
  /// unindexed on purpose — this one gains rows forever and is queried by
  /// employee on every `/me` request and by overlap on every write.
  ///
  /// `[employeeId, status]` serves both: listing one person's requests, and the
  /// overlap check that asks whether *this* person already has an `APPROVED`
  /// request touching the span. The composite leads with the selective column.
  @@index([employeeId, status])
  @@index([leaveTypeId])
  /// The HR list defaults to the current year and orders by date, both of which
  /// are ranges over this column.
  @@index([startDate])
  @@map("leave_requests")
}

/// One person named as cover for one leave request.
///
/// A table rather than an array column on [LeaveRequest], for the reason
/// [TimesheetApprovalEmail] is one — but here the argument is stronger, because
/// each entry is a *foreign key*: an array of ids would be a relation the
/// database could not enforce, so a replacement could name an employee who had
/// since been deleted and nothing would notice.
///
/// The primary key is the pair, which states the rule directly: a person may
/// cover a request once. Listing somebody twice is not a stronger nomination,
/// and without the constraint it would silently double every count taken over
/// this table.
///
/// There is no `id` and no `updatedAt`. Nothing about a nomination is editable —
/// changing who covers a request is removing one row and adding another, which
/// is what the API does when a `PENDING` request is patched — so the pair is the
/// whole identity and a surrogate key would only add a second way to name it.
model LeaveRequestReplacement {
  leaveRequestId String       @map("leave_request_id")
  /// `Cascade`, and the only cascade in this schema. A nomination is part of the
  /// request rather than a fact of its own: it says nothing once the request it
  /// belongs to is gone, so deleting a `PENDING` request takes its replacements
  /// with it. Every other foreign key here is `RESTRICT`, because everything
  /// else they point at outlives them.
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  /// `RESTRICT`, like every other reference to a person: an employee who is
  /// covering somebody's leave cannot be deleted out from under the request.
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([leaveRequestId, employeeId])
  /// The primary key leads with `leave_request_id`, so "which requests is this
  /// person covering" — the question the replacement-availability check asks on
  /// every write — cannot use it.
  @@index([employeeId])
  @@map("leave_request_replacements")
}

/// How much leave one employee has, of one kind, in one year.
///
/// The row HR creates by hand. Nothing here is derived from a contract, a
/// seniority level or a hire date, and **nothing is created automatically** —
/// adding an employee grants them nothing until somebody allocates it. That is
/// deliberate: entitlement is negotiated, and a number the system invented would
/// be indistinguishable from a number somebody agreed to.
///
/// **`remainingDays` is not a column, and must never become one.** It is
/// `allocatedDays + carriedOverDays - usedDays`, computed by the API on the way
/// out. Storing it would give the same fact two homes, and the day an `UPDATE`
/// touched one and not the other, the database would hold a balance that
/// contradicts its own parts. The three stored numbers are the single source of
/// truth; the fourth is a view of them.
///
/// The four are separate columns rather than one running total because they
/// answer different questions and are written by different hands: HR sets
/// `allocatedDays` and `carriedOverDays`, the Leave Requests feature moves
/// `usedDays`, and Feature 024's year-end generation writes `expiredDays`. A
/// single total would lose which of the four changed, and with it any way to
/// audit a balance that looks wrong — or to tell days somebody took from days
/// somebody forfeited.
model EmployeeLeaveBalance {
  id String @id @default(cuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  /// The calendar year the grant belongs to — 2026, not a date range. Leave is
  /// budgeted by the year everywhere this company operates, and a year is what
  /// the unique constraint needs to make "one balance per person per type per
  /// year" statable.
  year Int

  /// Days granted for this year by HR. Required and not defaulted: a balance
  /// exists because somebody decided a number, and `0` is a decision that has to
  /// be typed rather than one the schema makes on their behalf.
  allocatedDays Int @map("allocated_days")

  /// Days brought forward from earlier years. Defaulted to `0`, which is the
  /// answer for a first year and for a company that carries nothing over.
  ///
  /// Kept apart from `allocatedDays` because the two expire differently and are
  /// consumed in a different order — carried-over days first, oldest year first,
  /// as the Leave Requests feature will implement. Added together at entry, that
  /// ordering could never be applied.
  carriedOverDays Int @default(0) @map("carried_over_days")

  /// Days already consumed by approved leave. Defaulted to `0`.
  ///
  /// Maintained by hand in this feature and by the Leave Requests feature later,
  /// which is why it is a plain column rather than a count of request rows: the
  /// requests do not exist yet, and a balance opened with days already taken —
  /// an employee joining mid-year from another system — has to be expressible.
  usedDays Int @default(0) @map("used_days")

  /// Days written off at a year-end because the leave type's carry-over policy
  /// did not let them survive. Defaulted to `0`.
  ///
  /// **This column is what makes a carry-over cap mean anything.** Balances are
  /// consumed oldest year first and `findAvailable` reads every year up to the
  /// one being requested, so a remainder left in a closed year is *already*
  /// spendable in the next — carrying nothing forward is the system's natural
  /// behaviour, and it has no ceiling. Expiring the surplus in place is
  /// therefore the operation, and copying the survivors into the new year's
  /// [carriedOverDays] would count the same days twice.
  ///
  /// Kept apart from `usedDays` because the two are different facts: `usedDays`
  /// is leave somebody took, and this is leave somebody lost. Folded together,
  /// no report could tell an employee who used their allowance from one who
  /// forfeited it, and the year-end job would look like it had approved
  /// absences nobody requested.
  ///
  /// Written by Feature 024's generation and by `PATCH` for corrections; never
  /// by an approval.
  expiredDays Int @default(0) @map("expired_days")

  /// Free-text HR note: why the allocation is what it is. Optional, and read by
  /// nothing — it is for the person who opens this screen next year and wonders.
  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One balance per employee, per leave type, per year — the rule the feature
  /// is built on, stated where it cannot be bypassed. `EmployeeLeaveBalanceService`
  /// checks it first to produce a `409` naming the three values, but this index
  /// is what closes the race between that check and the insert.
  @@unique([employeeId, leaveTypeId, year])
  /// `?leaveTypeId=` and `?year=` are the two filters the unique index above
  /// cannot serve: it leads with `employee_id`, so neither of the others can use
  /// it on its own. Unlike the configuration tables — which hold tens of rows
  /// and are deliberately left unindexed — this one grows by every employee ×
  /// every leave type × every year, forever, so the scan it would otherwise do
  /// gets steadily more expensive.
  @@index([leaveTypeId])
  @@index([year])
  @@map("employee_leave_balances")
}

/// An address notified when leave activity needs attention.
///
/// A table rather than an array column, for the reason [TimesheetApprovalEmail]
/// is one: each address is addressable on its own, so
/// `DELETE /leave-notification-emails/:id` removes one without rewriting the
/// rest, and `email` gets a unique index that an array could not have.
///
/// Unlike [TimesheetApprovalEmail] it carries no foreign key to anything. There
/// is no configuration row for it to hang off — the list *is* the
/// configuration, maintained as its own resource, and `PATCH` corrects a typo
/// in an address rather than deleting and re-adding it.
model LeaveNotificationEmail {
  id String @id @default(cuid())

  email String @unique

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("leave_notification_emails")
}

/// An address notified when a timesheet needs approval.
///
/// A table rather than an array column on `WorkSchedule`, because each address
/// is addressable on its own: `DELETE /work-schedule/emails/:id` removes one
/// without rewriting the rest, and `email` gets a unique index that an array
/// could not have.
model TimesheetApprovalEmail {
  id String @id @default(cuid())

  /// Unique across the table, not merely within one schedule. There is exactly
  /// one schedule, so the two are the same set today — and stating it on the
  /// column is what makes the duplicate check a database guarantee rather than
  /// a race between a read and a write.
  email String @unique

  workScheduleId String       @map("work_schedule_id")
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("timesheet_approval_emails")
}

/// One message, in one of the two notification workspaces.
///
/// **This table stores and serves notifications. It does not produce them.**
/// Nothing in this schema writes a row here as a consequence of anything else:
/// approving leave, submitting a timesheet and finishing an import all leave it
/// untouched today. Deciding *when* a notification is born, and delivering it by
/// email or over a socket, is the Notification Delivery Engine — a later feature
/// — and separating the two is what lets this one be read, filtered and paged
/// without anything having to be scheduled, queued or sent. See the feature
/// document for the whole argument.
///
/// **Addressing lives in three columns, and only two shapes ever fill them.**
/// [recipientType] says which: `USER` sets `recipient_user_id` and leaves
/// `recipient_role` null, `ROLE` does the reverse, and the two broadcasts leave
/// both null. `NotificationService` enforces that, together with the rule that
/// only four of the eight workspace/recipient pairings are legal. Neither is a
/// CHECK constraint — the pairing rule and the null rule are one rule, stated
/// once in the service, rather than half of it duplicated where nobody reading
/// the other half would see it.
///
/// **`recipient_role` is a [UserRole], not a notification-specific enum**, and
/// that is deliberate. The three administrative roles already have stored
/// spellings — `superadmin`, `admin`, `hr` — and a second vocabulary saying
/// `super_admin` would mean every query joining a notification to the person
/// reading it had to translate between them, forever. The column's type
/// therefore also admits `USER`, which is not a legal value here; the service
/// refuses it, and `ADMINISTRATIVE_ROLES` in
/// `src/common/constants/role.constants.ts` is the one list of the three that
/// are legal.
model Notification {
  id String @id @default(cuid())

  /// Which inbox this belongs to. Not defaulted: a notification is written for
  /// one audience or the other, and guessing which would file back-office
  /// messages in employees' personal lists.
  workspace NotificationWorkspace

  recipientType NotificationRecipientType @map("recipient_type")

  /// The one account addressed, for `USER` notifications; null for every other
  /// recipient type.
  ///
  /// `Cascade` on delete, and the second cascade in this schema after
  /// `leave_request_replacements`. The argument is the same: a notification
  /// addressed to one person says nothing once that person's account is gone —
  /// nobody can read it and no list will ever return it — so keeping it would
  /// only make an account undeletable for the sake of messages nobody can see.
  /// Every reference to a *person* elsewhere is `RESTRICT`, because those record
  /// something that happened; this records something somebody was told.
  recipientUserId String? @map("recipient_user_id")
  recipientUser   User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  /// The one administrative role addressed, for `ROLE` notifications; null for
  /// every other recipient type. Only `SUPERADMIN`, `ADMIN` and `HR` are legal —
  /// see the note on this model for why the column's type is wider than the rule.
  recipientRole UserRole? @map("recipient_role")

  /// The one-line heading. Bounded at 150 characters by the API rather than by
  /// the column, like every other free text here: 150 is a rule about what fits
  /// on a screen, not a format the way `VarChar(7)` is for a colour.
  title String

  /// The body. Plain text, bounded at 5000 by the API. No markup is rendered and
  /// none is stripped — a client displays this as text, which is what keeps a
  /// message somebody typed from becoming markup somebody injected.
  message String

  /// Where the notification came from, what it looks like, and how loudly it
  /// asks. All three are defaulted, so a caller states only what departs from
  /// "an ordinary informational notice of normal importance" — the same call
  /// `Project.projectStatus` and `projectPriority` make, and for the same reason:
  /// an unstated priority is *normal*, not *unknown*.
  category NotificationCategory @default(GENERAL)
  type     NotificationType     @default(INFO)
  priority NotificationPriority @default(MEDIUM)

  /// Whether it has been read, and when.
  ///
  /// **One flag for the whole row, which is exactly right for a notification
  /// addressed to one person and a known limitation for a broadcast.** An
  /// `ALL_USERS` announcement is a single row read by everybody, so the first
  /// person to open it marks it read for all of them — and `DELETE
  /// /notifications/:id` removes it for all of them too. Correcting that needs a
  /// per-user `notification_reads` table, which is deferred rather than
  /// forgotten; the feature document states the trade-off and the migration path.
  ///
  /// Two columns rather than one, for the reason `leave_requests` keeps
  /// `processed_at` beside `status`: `updated_at` moves whenever any column does,
  /// so it cannot say when the notification was read. `read_at` is set when the
  /// flag is raised and is null while it is down; the two are written together
  /// and never independently.
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The two list queries this table exists to serve, plus their ordering.
  ///
  /// Unlike the configuration tables of Features 016–021 — tens of rows, left
  /// unindexed on purpose — this one gains a row for every event the delivery
  /// engine will ever announce, to every person it announces to, and never
  /// shrinks. Both lists are `WHERE workspace = … AND (addressed to me OR
  /// broadcast) ORDER BY created_at DESC`, so each index carries `created_at`
  /// last: PostgreSQL can then satisfy the filter and the sort from one scan
  /// instead of sorting the matches afterwards.
  ///
  /// `[recipientUserId, createdAt]` is the personal list's directly-addressed
  /// half, `[recipientRole, createdAt]` the administrative list's, and
  /// `[workspace, recipientType, createdAt]` covers both broadcasts and the
  /// workspace scope every query starts from.
  @@index([recipientUserId, createdAt])
  @@index([recipientRole, createdAt])
  @@index([workspace, recipientType, createdAt])
  @@map("notifications")
}

/// A rule saying that a reminder should go out a given number of days before a
/// deadline.
///
/// Configuration rather than data, like [WorkSchedule], [PublicHoliday] and
/// [LeaveType]: it describes *when the company wants to be reminded*, not that
/// anybody was reminded. **Nothing in this feature fires one.** No job runs, no
/// email is sent and no [Notification] is written; the Notification Delivery
/// Engine reads these rows, works out which deadlines are that many days away
/// and produces the messages. Keeping the rule and its execution apart is what
/// lets an administrator change "7 days" to "5 days" without a scheduler being
/// involved in the write.
///
/// **`daysBeforeDeadline` is an offset, not a date.** `0` is the deadline
/// itself and is a legal, deliberate value — "your timesheet is due today" is
/// the reminder people actually act on. The column therefore has no default: a
/// reminder exists because somebody chose an offset, and guessing one would
/// invent a rule nobody asked for.
///
/// **Which deadline is not named here**, and that is deliberate rather than an
/// omission. The only deadline this application has is the timesheet's, and the
/// Timesheets module does not exist yet; a `deadlineType` column would be a
/// vocabulary of one value, invented before the thing it describes. The engine
/// applies these rules to the timesheet deadline, and the day a second kind of
/// deadline exists this table gains a column rather than a meaning.
model Reminder {
  id String @id @default(cuid())

  /// What the rule is called, on the screen that lists them. Unique, so two
  /// administrators cannot end up maintaining two rules nobody can tell apart.
  ///
  /// The uniqueness is enforced twice, for two different failures:
  /// `ReminderService` folds case first — `Timesheet due` and `timesheet due`
  /// are the same rule to a person, while PostgreSQL's index sees two rows — and
  /// this index closes the exact-case race between that check and the insert.
  name String @unique

  description String?

  /// Whether the engine should act on this rule. Defaulted to `true`, because a
  /// reminder somebody just configured is one they want; switching it off is the
  /// deliberate act.
  ///
  /// A flag rather than a delete, for the reason [LeaveType.isActive] is one: a
  /// rule paused for a quarter keeps its wording, its offset and its name
  /// instead of having to be retyped.
  enabled Boolean @default(true)

  /// How many days before the deadline the reminder goes out. `0` is the
  /// deadline itself; negatives are refused by the API.
  daysBeforeDeadline Int @map("days_before_deadline")

  /// The heading and the body the engine will copy into whatever it produces.
  ///
  /// Stored as the message rather than as a template with placeholders, which is
  /// the call this feature makes deliberately: a placeholder vocabulary
  /// (`{{employee}}`, `{{deadline}}`) is a small language, and inventing one
  /// before a single reminder has been sent would fix its syntax before anything
  /// could show which substitutions are actually wanted. Templating belongs with
  /// the engine that renders it.
  subject String
  message String

  /// How the reminder is drawn and how loudly it asks.
  ///
  /// `severity` is a [NotificationType] — the enum the notification centre
  /// already stores in `notifications.type` — rather than a second enum of the
  /// same four values. That is the call [Notification.recipientRole] makes with
  /// `UserRole`, and for the same reason: the delivery engine copies this value
  /// straight into the notification it creates, and two vocabularies spelling
  /// `INFO` differently would mean translating between them at every hand-off,
  /// forever. The field is named for what it *is* to a reminder; the type is
  /// named for where it ends up.
  ///
  /// Both are defaulted, so a caller states only what departs from "an ordinary
  /// informational notice of normal importance".
  severity NotificationType     @default(INFO)
  priority NotificationPriority @default(MEDIUM)

  /// How the reminder reaches people. **At least one must be true**, which the
  /// API enforces and a column cannot: a rule that sends nothing by any channel
  /// is a rule that cannot fire, and storing it would put a reminder on the
  /// screen that silently never happens.
  ///
  /// The defaults are the pair the feature specifies and they are not
  /// symmetrical on purpose: an in-app notification is cheap and expected, while
  /// email leaves the system and lands in an inbox somebody has to clear, so it
  /// is the one that has to be asked for.
  sendEmail        Boolean @default(false) @map("send_email")
  sendNotification Boolean @default(true) @map("send_notification")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// No index beyond the unique one on `name`.
  ///
  /// The same call Features 016–021 make for their configuration tables: this
  /// holds a handful of rows — a company configures four or five reminders, not
  /// four thousand — and PostgreSQL scans that faster than it would descend an
  /// index. `notifications` is indexed because it grows without bound; this does
  /// not.
  @@map("reminders")
}

/// One announcement somebody composed by hand, to be delivered later.
///
/// The manual counterpart of [Reminder]: a reminder is a standing rule, this is
/// a single message about a single occasion — planned maintenance, a company
/// meeting, an office closure, an emergency notice.
///
/// **This table stores campaigns. It does not send them.** Creating one writes
/// no [Notification], sends no email, opens no socket and schedules no job;
/// `status` stays `DRAFT` or `SCHEDULED` and `sent_at` stays null until the
/// Notification Delivery Engine acts. That is the same separation the
/// notification centre keeps, one step earlier in the chain: the centre stores
/// what people were told, this stores what somebody intends to tell them, and
/// the engine is the only thing that turns the second into the first.
///
/// **`status` is derived from `scheduled_at` rather than chosen alongside it.**
/// A campaign carrying a schedule is `SCHEDULED`; one without is a `DRAFT`.
/// Accepting both as independent fields would let a row claim to be `SCHEDULED`
/// with no time to fire at — two fields stating one fact, and the engine would
/// have to decide which of them it believed. The two values a client *can* write
/// are the schedule and `CANCELLED`.
model NotificationCampaign {
  id String @id @default(cuid())

  /// The heading and the body, exactly as [Reminder] stores them and bounded by
  /// the API at the same 200 and 5000 characters. The two resources are worded
  /// by the same people on the same kind of screen; letting the bounds differ
  /// would mean an announcement that fits a reminder is refused as a campaign.
  subject String
  message String

  severity NotificationType     @default(INFO)
  priority NotificationPriority @default(MEDIUM)

  /// How the campaign reaches people. At least one must be true — see
  /// [Reminder.sendEmail].
  sendEmail        Boolean @default(false) @map("send_email")
  sendNotification Boolean @default(true) @map("send_notification")

  /// Where the campaign is in its lifecycle. Defaulted to `DRAFT`, which is what
  /// a campaign is the instant it is composed without a schedule.
  status NotificationCampaignStatus @default(DRAFT)

  /// When the engine should send it, or null for a draft nobody has scheduled.
  ///
  /// Required by the API to be in the future *when it is written*, and never
  /// re-judged afterwards: a campaign scheduled for last Tuesday that the engine
  /// has not yet reached is late, not invalid, and refusing to edit its wording
  /// for that reason would punish the caller for time passing.
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)

  /// When the announcement stops being worth showing, or null for one that never
  /// goes stale.
  ///
  /// Later than `scheduled_at` whenever both are set, which the API enforces:
  /// an expiry at or before the send is a campaign that is over before it
  /// begins. Nothing here acts on it — the engine decides what an expired
  /// campaign means for a notification already delivered.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  /// When the engine actually sent it. **Null throughout this feature**, and the
  /// column exists anyway so the engine has somewhere to record the fact without
  /// a migration.
  ///
  /// Kept apart from `scheduled_at` because the two are different facts — when
  /// it was meant to go, and when it went — and from `updated_at`, which moves
  /// whenever any column does and so cannot say when a campaign was sent. The
  /// same argument `leave_requests` makes for `processed_at`.
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)

  /// Who composed it.
  ///
  /// An employee rather than a user, so the author can be rendered as a name
  /// beside the campaign without a second join through `users` — the call
  /// `leave_requests.processed_by_id` already makes. Required: a campaign is
  /// something a person wrote, and a null author would be a message the company
  /// sent with nobody accountable for its wording.
  ///
  /// `RESTRICT`, like every other reference to a person that records something
  /// somebody did. `notifications.recipient_user_id` cascades because it records
  /// something somebody was *told*, which says nothing once they are gone; this
  /// records an act, and the act outlives the actor's employment record.
  createdByEmployeeId String   @map("created_by_employee_id")
  createdBy           Employee @relation(fields: [createdByEmployeeId], references: [id])

  /// Who it is for. At least one, enforced by the API rather than by the schema
  /// — a column cannot require a row in another table to exist.
  recipients NotificationRecipient[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The query the delivery engine will run on every tick: *which campaigns are
  /// scheduled, and due?*
  ///
  /// `WHERE status = 'scheduled' AND scheduled_at <= now()`, which is exactly
  /// this index — the selective equality first, the range second. Unlike
  /// [Reminder] this table does grow: a campaign per announcement, kept as a
  /// record after it is sent.
  @@index([status, scheduledAt])
  /// PostgreSQL does not index a foreign key on its own, and this one is read
  /// backwards: deleting an employee has to find the campaigns they wrote before
  /// `RESTRICT` can refuse.
  @@index([createdByEmployeeId])
  @@map("notification_campaigns")
}

/// One audience entry on one campaign.
///
/// **`ALL_EMPLOYEES` stores exactly one row, with a null `employee_id`** — never
/// one row per employee. That is the feature's central storage decision and it
/// is worth stating on the table itself:
///
///  - a company-wide announcement writes 1 row instead of N, and a company of a
///    thousand people would otherwise pay a thousand inserts to say one thing;
///  - the audience is resolved *when the campaign is sent*, so somebody hired
///    between composing and sending is included, and somebody who left is not.
///    Expanded at composition time the list would freeze the directory as it was
///    on the day somebody typed the message;
///  - the stored rows say what the author *meant* — "everybody" — rather than
///    the accident of who happened to be employed that afternoon, which is what
///    makes the campaign screen able to show "All employees" instead of a list
///    of names nobody chose.
///
/// The two shapes are exclusive: a campaign holds either one `ALL_EMPLOYEES` row
/// or N `EMPLOYEE` rows, and `NotificationCampaignService` enforces that.
/// Mixing them would be a campaign addressed to everybody *and* to three people
/// in particular, which is the first list twice.
///
/// It has a surrogate `id`, unlike [LeaveRequestReplacement] whose identity is
/// its pair of foreign keys. It has to: `employee_id` is nullable here, so the
/// pair cannot be a primary key, and the `ALL_EMPLOYEES` row would have no
/// identity at all.
model NotificationRecipient {
  id String @id @default(cuid())

  /// `Cascade`, and the third in this schema. A recipient is part of a campaign
  /// rather than a fact of its own — it says nothing once the campaign it
  /// belongs to is gone — so deleting a campaign takes its audience with it, the
  /// same argument `leave_request_replacements` makes.
  campaignId String               @map("campaign_id")
  campaign   NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  recipientType CampaignRecipientType @map("recipient_type")

  /// The one person addressed, for `EMPLOYEE` rows; null for the `ALL_EMPLOYEES`
  /// row.
  ///
  /// `RESTRICT`, like every other reference to a person: somebody named in an
  /// announcement cannot be deleted out from under it.
  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id])

  /// No `updatedAt`. Nothing about an audience entry is editable — changing who
  /// a campaign is for means replacing the set, which is what `PATCH` does — so
  /// a modification timestamp would only ever repeat `created_at`.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// One entry per person per campaign. Listing somebody twice is not a stronger
  /// nomination, and without the constraint it would double every count taken
  /// over this table — the same rule `leave_request_replacements` states through
  /// its primary key.
  ///
  /// It does **not** constrain the `ALL_EMPLOYEES` row: PostgreSQL treats nulls
  /// as distinct in a unique index, so two such rows would satisfy it. That rule
  /// is the service's, and it has to be — "one `ALL_EMPLOYEES` row, and no
  /// `EMPLOYEE` rows beside it" is a statement about the whole set rather than
  /// about a pair of columns.
  @@unique([campaignId, employeeId])
  /// The unique index leads with `campaign_id`, so "which campaigns name this
  /// person" — the question a `RESTRICT`ed employee delete asks — cannot use it.
  @@index([employeeId])
  @@map("notification_recipients")
}

/// One thing somebody may be allowed to do: a (resource, action) pair.
///
/// **The vocabulary of permissions, and vocabulary is seeded rather than
/// managed.** There is no `POST /permissions` and no `DELETE /permissions/:id`,
/// deliberately: a permission row is meaningless unless something in the
/// application actually checks it, so inventing one through an API would produce
/// a cell on the matrix screen that nothing anywhere reads. New permissions
/// arrive with the feature that enforces them — as a seed entry and a migration —
/// which is the same call Feature 003 recorded for how roles and permissions
/// would be added. See `prisma/seeds/permissions.seed.ts` for the exact matrix.
///
/// `key` is the addressable name — `TIMESHEET.CREATE` — and it is stored rather
/// than derived from the two enums on every read. Three reasons: it is what an
/// API body, an audit line and a future `@RequirePermission('TIMESHEET.CREATE')`
/// all quote, so it has to be one literal rather than a formatting convention
/// each of them repeats; it is what `?search=` matches; and it is the natural key
/// the seeds resolve ids by, which is what lets a later seed name a permission
/// without knowing its cuid.
///
/// **Only the meaningful pairs exist.** The twelve resources and seven actions
/// would multiply out to eighty-four rows, and most of them would be nonsense —
/// `DASHBOARD.DELETE` names nothing, `WORK_SCHEDULE.CREATE` names a second copy
/// of a table that holds exactly one row. Fifty-five pairs are seeded; the matrix
/// screen renders an empty cell where a pair does not exist, which is the honest
/// rendering of "this cannot be granted because it cannot be done".
model Permission {
  id String @id @default(cuid())

  /// `RESOURCE.ACTION`, upper case, dot separated. Unique, because it is how
  /// every other layer names this row.
  key String @unique

  resource PermissionResource
  action   PermissionAction

  /// What the cell says on the matrix — `Create`, `Approve`, `Page access`.
  ///
  /// Stored rather than title-cased from `action` on the way out, so a screen can
  /// call `LEAVES.CONFIGURE` "Configure leave policies" where a generic
  /// "Configure" would leave an administrator guessing which policies. The seed
  /// is what decides; nothing derives it.
  label String

  /// A sentence explaining what granting this actually permits. Nullable,
  /// because the obvious pairs explain themselves and a description invented for
  /// each of fifty-five rows would be noise nobody reads.
  description String?

  /// What a role holds by default, what a preset bundles, where a user departs
  /// from their role, and what the history records. Every one of them is
  /// `RESTRICT` on delete — see each model for why.
  rolePermissions RolePermission[]
  presetItems     PermissionPresetItem[]
  userOverrides   UserPermissionOverride[]
  auditEntries    PermissionAuditLog[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The catalog is filtered by resource, by action, or by both — the three
  /// shapes the matrix screen asks for — and this serves all three plus the
  /// default ordering. It holds fifty-five rows, so the index states the access
  /// pattern rather than rescuing a scan; unlike `notifications`, this table does
  /// not grow with use.
  @@index([resource, action])
  @@map("permissions")
}

/// What a role grants by default — the baseline every user of that role starts
/// from.
///
/// **`SUPERADMIN` is not stored here, and must never be.** A super-admin holds
/// every permission, which is not a set somebody configured but a statement about
/// what the role *is*: the account that can always fix the system, including a
/// permission matrix somebody has locked themselves out of. Seeded as rows it
/// would be a set that could be edited, and the first edit would create a
/// super-admin who could no longer administer. It is therefore one branch in
/// `PermissionService.resolveEffective` and nothing else — see that method.
///
/// The role is the existing [UserRole] rather than a second role vocabulary. A
/// `permission_roles` table would mean `users.role` and a role row could disagree
/// about who somebody is, and every query joining a person to their permissions
/// would translate between two spellings of `admin` forever. The call
/// [Notification.recipientRole] already makes.
///
/// There is no runtime API for this table either. Changing what a *role* means is
/// a decision about the product, not about one person — the per-user override is
/// how one person is treated differently — so the baseline is seeded and a
/// deviation is a [UserPermissionOverride].
model RolePermission {
  id String @id @default(cuid())

  role UserRole

  /// `RESTRICT`: the catalog outlives its bindings. A permission still bound to a
  /// role is one the application checks somewhere, and deleting it would leave
  /// every user of that role silently missing a grant nobody removed.
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  /// No `updatedAt`. A binding is not editable — a role either grants a
  /// permission or does not — so a modification timestamp would only ever repeat
  /// `created_at`, the call [NotificationRecipient] already makes.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// One binding per role per permission. Listing it twice is not a stronger
  /// grant, and without the constraint it would double every count taken over
  /// this table.
  @@unique([role, permissionId])
  /// The unique index leads with `role`, so "which roles grant this permission" —
  /// the question a `RESTRICT`ed permission delete asks — cannot use it.
  @@index([permissionId])
  @@map("role_permissions")
}

/// A named bundle of permissions an administrator can apply to somebody in one
/// click — the quick-apply cards on the permissions screen.
///
/// **Its own table rather than more [UserRole] values**, and the distinction is
/// the point: a role is *who somebody is*, stored on their account and read by
/// everything from notification addressing to the administrative workspace; a
/// preset is *a set of permissions somebody named*, applied once and then
/// irrelevant. Spelling "HR - View Only" as a role would put six more values into
/// an enum that four other features already branch on, and would make a person's
/// role change every time their permissions were adjusted.
///
/// Applying a preset stores no link to it. The user's overrides are recomputed so
/// their effective set equals the preset, and the fact that a preset was the
/// reason is recorded in [PermissionAuditLog] rather than on the account —
/// because it stops being true the moment somebody toggles one cell, and a column
/// claiming "this user is on HR - Standard" would then be a label disagreeing
/// with the matrix underneath it.
///
/// Seeded like the catalog, and for the same reason: a preset is a recommendation
/// this product makes. Editing them is a later feature.
model PermissionPreset {
  id String @id @default(cuid())

  /// `HR_FULL_ACCESS` — the stable name a body quotes and a seed resolves by.
  key String @unique

  /// `HR - Full Access` — what the card says.
  name String

  description String?

  /// Which role the preset was written for, and **only** which role it is
  /// *grouped under* on the screen. It is not a constraint: a preset may be
  /// applied to any account that is not a super-admin, because "give this
  /// particular USER what an HR person gets" is a real thing an administrator
  /// does, and refusing it would send them to toggle thirty-five cells by hand.
  ///
  /// `SUPERADMIN` is not a legal value — that role holds everything and cannot be
  /// modified, so a preset for it would be a card that does nothing. The column's
  /// type is nevertheless the whole enum, because the rule belongs with the seed
  /// that writes these rows rather than restated as a narrower type the database
  /// cannot express.
  targetRole UserRole @map("target_role")

  items PermissionPresetItem[]

  /// The history rows that name this preset as the reason for a change.
  auditEntries PermissionAuditLog[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The preset list is filtered by `?targetRole=` and ordered by it, over six
  /// rows. Indexed for the reason `permissions` is: to state the access pattern,
  /// not to rescue a scan.
  @@index([targetRole])
  @@map("permission_presets")
}

/// One permission inside one preset.
///
/// A join table rather than an array of keys on [PermissionPreset], because each
/// entry is a *foreign key*: an array of strings would be a relation the database
/// could not enforce, so a preset could name a permission that had since been
/// renamed and nothing would notice until somebody applied it. The argument
/// [LeaveRequestReplacement] makes, applied to a catalog instead of to people.
model PermissionPresetItem {
  id String @id @default(cuid())

  /// `Cascade`. An item is part of its preset rather than a fact of its own — it
  /// says nothing once the preset is gone — the same call
  /// `notification_recipients.campaign_id` makes.
  presetId String           @map("preset_id")
  preset   PermissionPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  /// `RESTRICT`, like every other reference to the catalog: a permission a preset
  /// hands out cannot be deleted out from under it.
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// One entry per permission per preset — listing it twice does not grant it
  /// twice, and would double the `permissionCount` the preset cards render.
  @@unique([presetId, permissionId])
  /// The unique index leads with `preset_id`, so "which presets hand out this
  /// permission" — what a `RESTRICT`ed permission delete asks — cannot use it.
  @@index([permissionId])
  @@map("permission_preset_items")
}

/// One place where one user departs from what their role grants.
///
/// **Only the deviation is stored, never a copy of the matrix.** A user whose
/// permissions are exactly their role's has zero rows here; a user who has been
/// given one extra permission has exactly one. That is the feature's central
/// storage decision, and it earns three things at once:
///
///  - the table stays proportional to the *exceptions* an organisation actually
///    makes rather than to (users × fifty-five permissions);
///  - "reset this person to their role" is `DELETE FROM user_permission_overrides
///    WHERE user_id = …`, an operation that cannot half-succeed, instead of a
///    rewrite of every row to match a baseline read from somewhere else;
///  - and, most importantly, **a change to a role baseline reaches everybody it
///    should.** With the full matrix copied per user, the day `HR` gained a
///    permission every existing HR user would keep the frozen copy taken when
///    their account was set up, and the new grant would apply only to people
///    hired afterwards. Storing the exception means the baseline is read fresh
///    every time and the exception survives on top of it.
///
/// An override that *agrees* with the baseline is therefore never written.
/// `UserPermissionService` normalises every submitted matrix against the role
/// before persisting, so a `GRANT` of something the role already gives is dropped
/// rather than stored — it states a fact the baseline already states, and the two
/// copies would disagree the moment the baseline changed.
///
/// There are no rows here for a `SUPERADMIN`, and the API refuses to write any.
/// See [RolePermission].
model UserPermissionOverride {
  id String @id @default(cuid())

  /// `Cascade`, and the fourth in this schema. An override says nothing once the
  /// account it qualifies is gone: nobody can hold it, no resolution will ever
  /// read it, and keeping it would only make an account undeletable for the sake
  /// of exceptions to a role nobody has any more. The same argument
  /// `notifications.recipient_user_id` makes.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `RESTRICT`: the catalog outlives the exceptions taken against it.
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  /// Which way the deviation runs. `GRANT` is a permission the role does not give
  /// and this person has; `REVOKE` is one the role gives and this person does not.
  effect PermissionEffect

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kept, unlike [RolePermission] and [PermissionPresetItem], because this row
  /// genuinely changes: flipping a cell from granted to revoked updates `effect`
  /// in place rather than deleting and re-inserting, so "when was this exception
  /// last touched" is a question the column can answer.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One override per user per permission. It is what makes "the exception" a
  /// singular noun: two rows for one cell would be a user simultaneously granted
  /// and denied, and no resolution could choose between them.
  ///
  /// It also serves the read this table exists for — every override of one user,
  /// which every effective resolution runs — because it leads with `user_id`. A
  /// separate index on `user_id` alone would duplicate that leading column.
  @@unique([userId, permissionId])
  /// The unique index leads with `user_id`, so "who has an exception on this
  /// permission" — what a `RESTRICT`ed permission delete asks — cannot use it.
  @@index([permissionId])
  @@map("user_permission_overrides")
}

/// What was changed about somebody's permissions, by whom, and from what to what.
///
/// The history tab, and the reason every write in this module is a transaction.
/// **Audit rows are written in the same `$transaction` as the override rows they
/// describe**, never afterwards: a history written separately would be a second
/// statement about one event, and the run where the second statement failed would
/// leave a permission granted with nothing recording who granted it — which is
/// the one question an audit trail exists to answer. Sharing the transaction
/// makes "the history disagrees with the state" unreachable rather than unlikely.
///
/// Each row is one *transition*, not a snapshot: `previous_effect` and
/// `new_effect` are the override state before and after, and either may be null
/// because "no override" is a legitimate end of a transition in both directions.
/// A snapshot per change would grow by fifty-five rows per click and still not say
/// what actually moved.
///
/// `permission_id` is nullable, and exactly two of the five actions leave it null:
/// `PRESET_APPLIED` and `RESET_TO_ROLE` are summaries of a whole operation,
/// written once beside the per-permission rows that make it up. The alternative —
/// a separate summary table — would mean the history tab reading two tables and
/// interleaving them by timestamp to render one list.
model PermissionAuditLog {
  id String @id @default(cuid())

  /// Whose permissions changed.
  ///
  /// `Cascade`, and the deliberate half of an asymmetric pair. This history is
  /// only ever read through `GET /users/:id/permissions/history`, a route scoped
  /// to an account: once the account is deleted the rows are unaddressable, and
  /// the overrides they describe have cascaded away too, so keeping them would
  /// preserve a history of a state that no longer exists while making the account
  /// undeletable. It would also silently change what `DELETE /users/:id` means —
  /// Feature 009 refuses that call only when an employee is linked — for every
  /// account whose permissions somebody had once edited.
  ///
  /// The trade-off is real and is recorded in the feature document: a compliance
  /// regime requiring permission changes to outlive the account needs an
  /// append-only export or a nullable target, not a foreign key.
  targetUserId String @map("target_user_id")
  targetUser   User   @relation("PermissionAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  /// Who made the change, taken from `@CurrentUser()` and never hardcoded.
  ///
  /// `RESTRICT` — the other half of the asymmetry, and the schema's standing rule
  /// for every reference to a person that records something somebody *did*
  /// (`notification_campaigns.created_by_employee_id`,
  /// `leave_request_replacements.employee_id`). Granting somebody a permission is
  /// an act, and the act outlives the actor's account: an administrator cannot be
  /// deleted out from under the record of what they authorised, which is the
  /// difference between an audit trail and a list.
  changedByUserId String @map("changed_by_user_id")
  changedBy       User   @relation("PermissionAuditActor", fields: [changedByUserId], references: [id])

  /// Which permission moved, or null on the summary row of a bulk operation.
  ///
  /// `RESTRICT`, like every other reference to the catalog. A permission named in
  /// the history cannot be deleted out from under it — the history would
  /// otherwise say that *something* had been granted.
  permissionId String?     @map("permission_id")
  permission   Permission? @relation(fields: [permissionId], references: [id])

  action PermissionAuditAction

  /// The override state before and after. Both nullable, because null is the
  /// meaningful value at both ends: null → `GRANT` is a permission added on top
  /// of the role, `REVOKE` → null is an exception withdrawn so the role applies
  /// again. Both null on the two summary actions, which describe an operation
  /// rather than a cell.
  previousEffect PermissionEffect? @map("previous_effect")
  newEffect      PermissionEffect? @map("new_effect")

  /// The preset that was applied, on a `PRESET_APPLIED` summary row; null on
  /// everything else.
  ///
  /// `RESTRICT`, for the reason the catalog is: a history line saying "a preset
  /// was applied" without being able to say which one has lost the fact it was
  /// written to record.
  presetId String?           @map("preset_id")
  preset   PermissionPreset? @relation(fields: [presetId], references: [id])

  /// No `updatedAt`. An audit row records a moment and is never edited; a
  /// modification timestamp on one would be an invitation to.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// The one read this table is built for: one user's history, newest first.
  /// `created_at` comes second so PostgreSQL satisfies the filter and the sort
  /// from a single scan instead of sorting the matches afterwards — the call
  /// `notifications` makes for its three list indexes. Unlike the four tables
  /// above, this one grows for as long as people administer the system.
  @@index([targetUserId, createdAt])
  /// The three foreign keys the index above does not lead with. Each is read
  /// backwards by a delete: `RESTRICT` has to find the rows referencing a user, a
  /// permission or a preset before it can refuse.
  @@index([changedByUserId])
  @@index([permissionId])
  @@index([presetId])
  @@map("permission_audit_logs")
}

/// One employee's account of one month — the header of a timesheet.
///
/// **A header and its lines rather than one flat table of hours**, and the split
/// is the model's central decision. A timesheet has facts that belong to the
/// *month* and not to any day in it: whether it has been submitted, who reviewed
/// it, why it was refused, whether the schedule it was filled against has since
/// changed. Hung off the entries those facts would have to be repeated on every
/// row and could then disagree — twenty lines each claiming a different reviewer
/// — and a month with no hours logged yet could not exist at all, which is
/// exactly the state `DRAFT` describes. The header is the unit that is submitted,
/// approved and rejected; the lines are what it says.
///
/// **`(employee_id, month, year)` is unique**, which is the rule the whole
/// feature rests on: a person accounts for a month once. Two timesheets for one
/// month would be two answers to "how much did this person work in September",
/// and no reader could choose between them — so `POST /timesheets/me` is
/// idempotent, and this index is what makes that a guarantee rather than a race
/// between a lookup and an insert.
///
/// `month` and `year` are two integers rather than a `DATE` pinned to the first
/// of the month. They are what the URL carries (`?month=9&year=2026`), what the
/// unique constraint is stated in, and what a person means by "a timesheet" — a
/// date column would invite the first of October to be a different timesheet from
/// October, and every query would have to normalise before comparing.
model Timesheet {
  id String @id @default(cuid())

  /// Whose month this is. Never changes after creation — a timesheet filed by
  /// the wrong person is deleted while it is not approved, not reassigned,
  /// because reassigning it would move a record of work between two people with
  /// nothing saying it happened. The same call `leave_requests.employee_id` makes.
  ///
  /// `RESTRICT`, like every other reference to a person that records something
  /// somebody *did*. A month somebody worked is not erased because their
  /// personnel record is removed: `EmployeeService.remove` already refuses to
  /// delete anybody with leave or memberships behind them, and a timesheet is a
  /// stronger reason still — it is what payroll and reporting are eventually
  /// drawn from.
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  /// 1–12 and a four-digit year, both bounded by the API. A timesheet for a
  /// *future* month is refused: there is nothing to account for yet.
  month Int
  year  Int

  /// Where the month stands. Defaulted to `DRAFT`, which is what a timesheet is
  /// the instant it is opened — a private working copy no administrator sees.
  status TimesheetStatus @default(DRAFT)

  /// When the owner submitted, and when an administrator decided.
  ///
  /// Two columns rather than one, and both nullable, for the reason
  /// `leave_requests` keeps `processed_at` beside `status`: `updated_at` moves
  /// whenever any column does — including when [isStale] is raised — so it cannot
  /// say when a timesheet was handed in or when it was answered. `submittedAt`
  /// survives a rejection and is overwritten on resubmission, so it always names
  /// the submission the current status refers to.
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)

  /// Who approved or rejected it, or null while nobody has.
  ///
  /// An employee rather than a user, so a reviewer can be rendered as a name
  /// beside the timesheet without a second join through `users` — the call
  /// `leave_requests.processed_by_id` and `notification_campaigns.created_by_employee_id`
  /// both make.
  ///
  /// `SetNull` on delete, matching `leave_requests.processed_by_id` exactly: the
  /// fact that a decision was made survives the decider leaving the company, and
  /// `reviewedAt` keeps saying when it happened. It is the one reference to a
  /// person here that is not `RESTRICT`, because it records a decision *about*
  /// somebody else's work rather than the work itself.
  reviewedByEmployeeId String?   @map("reviewed_by_employee_id")
  reviewedBy           Employee? @relation("TimesheetReviewer", fields: [reviewedByEmployeeId], references: [id], onDelete: SetNull)

  /// Why it was refused. Required by the API on a rejection and refused on an
  /// approval, but nullable in the column: an approval carries no explanation,
  /// and a timesheet nobody has reviewed has nothing to explain.
  ///
  /// It is deliberately *not* cleared when the owner resubmits. The reason is
  /// what they were asked to fix, and blanking it the moment they act on it would
  /// leave the history of the month unable to say why it took two attempts.
  rejectionReason String? @map("rejection_reason")

  /// Something the timesheet was filled against has changed since — review it.
  ///
  /// **A flag rather than a recomputation**, and this is the decision that keeps
  /// the feature honest. Leave gets approved, holidays get corrected and the work
  /// schedule gets edited *after* people have filled their months in. Silently
  /// rewriting somebody's entries in response would mean an employee opening a
  /// timesheet to find hours they did not enter, with nothing saying who changed
  /// them; and refusing to let the dependencies change at all would freeze the
  /// company's calendar around its slowest timesheet.
  ///
  /// So the module changes nothing and says something. The flag is raised on a
  /// `DRAFT` or `SUBMITTED` timesheet whose dependencies have moved, the owner is
  /// notified once, and the *person* decides what their month should say. It is
  /// lowered when they save their entries again.
  ///
  /// Never raised on an `APPROVED` timesheet: that one is frozen, and see
  /// [scheduleSnapshot].
  isStale Boolean @default(false) @map("is_stale")

  /// The working-day and hours context this month was approved against, frozen.
  ///
  /// Written once, at approval, and never again. An approved timesheet is the
  /// record of what the company agreed somebody worked, so it must stay readable
  /// as it was agreed — and the rules it was judged by (which weekdays were
  /// worked, how many hours a day, which days were holidays) are configuration
  /// that keeps changing. Without the snapshot, opening a 2026 approval in 2028
  /// would judge it against 2028's schedule and report violations of a rule that
  /// did not exist when it was signed off.
  ///
  /// `Json` rather than columns, because it is a *photograph* rather than data:
  /// nothing queries inside it, nothing joins to it, and the day the work
  /// schedule grows a field the snapshot should grow one too without a migration
  /// per approval. Structured columns would be this table promising to keep a
  /// copy of another table's shape forever.
  ///
  /// Null on every timesheet that has not been approved, which is exactly the set
  /// that has nothing to freeze.
  scheduleSnapshot Json? @map("schedule_snapshot")

  /// What the month actually says. Possibly empty — a `DRAFT` nobody has filled
  /// in yet is a legitimate timesheet.
  entries TimesheetEntry[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One timesheet per person per month per year — the rule the feature is built
  /// on, stated where it cannot be bypassed. `TimesheetService.openOwn` checks it
  /// first so a second call returns the existing sheet rather than a `409`, but
  /// this index is what closes the race between that check and the insert.
  ///
  /// It also serves every read scoped to one person, because it leads with
  /// `employee_id`. A separate index on `employee_id` alone would duplicate that
  /// leading column and buy nothing — the call [UserPermissionOverride] already
  /// makes with its own unique constraint.
  @@unique([employeeId, month, year])
  /// The administrator's list is `WHERE status <> 'draft' AND month = … AND year
  /// = …`, and the status is the selective half of it: drafts are excluded from
  /// every administrative read, so this is the filter that runs on all of them.
  /// Unlike the configuration tables of Features 016–021 this one gains a row per
  /// employee per month, forever.
  @@index([status])
  /// PostgreSQL does not index a foreign key on its own, and this one is read
  /// backwards: `SetNull` has to find the timesheets an employee reviewed before
  /// it can blank them.
  @@index([reviewedByEmployeeId])
  @@map("timesheets")
}

/// One line of a timesheet: some hours, on one day, of one kind.
///
/// **A day holds as many of these as it needs, and that is the point.** The entry
/// list — not a column per day, and not one row per day — is the source of truth
/// for what a month says. Three hours on Project Alpha and five on Project Beta
/// is two rows on one date; a half-day of leave and half a day of work is two
/// rows on one date; a day nobody has filled in yet is no rows at all. A
/// per-day-per-timesheet unique constraint would make the first two unstatable,
/// and a `hours` column on a `timesheet_days` table would force every split to be
/// squeezed into a description somebody typed.
///
/// It follows that the day's total is a *sum* rather than a stored number, and
/// that the daily and weekly caps are checked over the set rather than against a
/// field. `TimesheetFillService` does that; nothing here computes anything.
model TimesheetEntry {
  id String @id @default(cuid())

  /// The month this line belongs to.
  ///
  /// `Cascade`, and the argument is the one `leave_request_replacements` and
  /// `notification_recipients` each make: a line says nothing once the timesheet
  /// it belongs to is gone. There is no reading of "five hours on Project Alpha"
  /// that survives the removal of the month it was booked in, and keeping the row
  /// would only make a deletable timesheet undeletable.
  timesheetId String    @map("timesheet_id")
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  /// The calendar day, at UTC midnight.
  ///
  /// A date rather than an instant, and the same convention `leave_requests` and
  /// `public_holidays` already store: a client posts `2026-09-07` and the column
  /// holds UTC midnight. Every comparison in the application is made in UTC, so
  /// which day an entry falls on cannot depend on where the server is deployed —
  /// a Monday read west of Greenwich would otherwise be the previous Sunday, and
  /// a weekday check would refuse an entry somebody made correctly.
  ///
  /// It must fall inside the header's own month; that is a rule about two rows at
  /// once, so the fill-in engine enforces it rather than a constraint.
  date DateTime

  /// What the hours account for.
  ///
  /// **`LEAVE` and `HOLIDAY` are not the employee's to write.** They are produced
  /// by the fill-in engine from the approved leave requests and the public
  /// holidays, and a submitted entry set that changes either one's type or hours
  /// is refused. That is not paternalism: hours somebody typed against an absence
  /// the company never approved would be an absence with no request behind it,
  /// which is precisely the thing the leave feature exists to record.
  type TimesheetEntryType

  /// The project the work was booked to.
  ///
  /// Required for `WORK` and refused for the other two — a rule about two columns
  /// at once, so the API enforces it rather than a CHECK constraint. `LEAVE` and
  /// `HOLIDAY` name no project because nobody was working: attributing an absence
  /// to a project would put hours in a project's total that were never worked on
  /// it.
  ///
  /// `RESTRICT`, like every reference here to something that outlives the line: a
  /// project with hours booked against it cannot be deleted out from under the
  /// timesheets that recorded them. `ProjectService` already refuses to delete a
  /// project with memberships; this is the same argument about a stronger record.
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id])

  /// How long, as `decimal(5, 2)` — never `double`.
  ///
  /// The same type and precision `work_schedules` states its bounds in, and the
  /// agreement is load-bearing rather than tidy: these are the numbers compared
  /// against `max_hours_per_day` and summed into a week. Binary floating point
  /// cannot hold `0.1` exactly, so a column of totals would drift by fractions of
  /// a second per row and a `>=` at the daily cap would come out differently
  /// depending on how the total was reached. Half and quarter hours are the
  /// granularity people book; `decimal` is exact for both.
  ///
  /// Always greater than zero, enforced by the API: an entry of no hours is not a
  /// shorter entry, it is the absence of one, and storing it would put a line on
  /// the screen that accounts for nothing.
  hours Decimal @db.Decimal(5, 2)

  /// The approved absence this line is justified by; null on `WORK` and
  /// `HOLIDAY`.
  ///
  /// It is what makes a `LEAVE` entry auditable: the hours are not a claim the
  /// employee typed but a consequence of a request somebody approved, and the
  /// link says which. Without it, "four hours of leave on the 7th" would be
  /// unfalsifiable.
  ///
  /// `SetNull` rather than `RESTRICT` or `Cascade`, and the choice is between
  /// three bad-looking options for a case that barely arises — only a `PENDING`
  /// request may be deleted, and a pending request has no timesheet entries. If
  /// one ever were removed, the *hours were still not worked*: cascading would
  /// delete a line from an approved month and change what the company signed off,
  /// while `RESTRICT` would make a timesheet entry able to veto the removal of
  /// somebody else's request. Blanking the link keeps the month intact and loses
  /// only the pointer, which is the smallest of the three losses.
  leaveRequestId String?       @map("leave_request_id")
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  /// What was done, in the employee's own words. Optional, and read by nothing —
  /// it is for the administrator reviewing the month and for the person who opens
  /// it again next year.
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The one read this table is built for: every line of one timesheet, in day
  /// order. `date` comes second so PostgreSQL satisfies the filter and the
  /// ordering from a single scan instead of sorting the matches afterwards — the
  /// call `notifications` and `permission_audit_logs` both make.
  @@index([timesheetId, date])
  /// The two foreign keys the index above does not lead with. Each is read
  /// backwards by a delete: `RESTRICT` has to find the entries booked to a
  /// project before it can refuse, and `SetNull` has to find the entries pointing
  /// at a leave request before it can blank them.
  @@index([projectId])
  @@index([leaveRequestId])
  @@map("timesheet_entries")
}

/// One issued refresh token, so that a session can be ended.
///
/// **This table exists because an access token cannot be revoked.** A JWT is
/// verified from its signature alone — no row is read, nothing is looked up —
/// which is exactly what makes it cheap and exactly what makes it final: once
/// signed, it is valid until it expires, and there is no place to write "this one
/// no longer counts". The answer is not to make access tokens stateful, which
/// would throw away the property they were chosen for; it is to keep them short
/// and to put the revocable half of the session here. Logging out, a stolen
/// token, a deactivated account — every one of them is enforced on this side.
///
/// One row per *issued* token rather than one per session, because rotation is
/// what makes a stolen refresh token detectable: each refresh invalidates the
/// token presented and stores its successor, so the rows of one login form a
/// chain. See [RefreshToken.replacedById].
model RefreshToken {
  id String @id @default(cuid())

  /// `Cascade`, and the fifth in this schema. A refresh token is a credential
  /// for an account and means nothing once that account is gone: nobody can
  /// present it, no refresh will ever match it, and keeping it would make an
  /// account undeletable for the sake of a session that can no longer exist. The
  /// same argument `user_permission_overrides.user_id` makes, and the opposite of
  /// the one `permission_audit_logs.changed_by_user_id` makes — this is not a
  /// record of something somebody *did*, it is a key they were handed.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, hex-encoded — never the token itself.
  ///
  /// A refresh token is a bearer credential: whoever holds the string can mint
  /// access tokens with it until it expires. Storing the raw value would mean a
  /// database dump, a backup on a laptop or a careless `SELECT *` in a support
  /// session handed out working sessions for every logged-in employee. Storing a
  /// hash makes the table useless to a reader: the server hashes what is
  /// presented and compares, and cannot reverse what it holds.
  ///
  /// SHA-256 rather than bcrypt, which is the deliberate half. bcrypt salts every
  /// call, so two hashes of one token differ and the only way to find a row would
  /// be to bcrypt-compare the presented token against *every* stored row —
  /// linear in the number of live sessions, on the hot path of every refresh. The
  /// reason bcrypt is right for a password and wrong here is what the two inputs
  /// are: a password is short, human-chosen and guessable, so hashing it must be
  /// slow; this is 32 bytes from a CSPRNG, which no amount of hardware
  /// enumerates, so a fast digest gives up nothing.
  ///
  /// `@unique` rather than a plain index. It is the lookup — a refresh presents a
  /// token and this is the only thing it can be found by — and it is also the
  /// guarantee that one token names at most one row, without which reuse
  /// detection would have to choose between two rows describing one credential.
  tokenHash String @unique @map("token_hash")

  /// When this token stopped being usable, or null while it still is.
  ///
  /// Set on three occasions, and they are the three ways a session ends: it was
  /// rotated (a refresh consumed it), the caller logged out, or the whole family
  /// was revoked because a consumed token came back — see
  /// [RefreshToken.replacedById].
  ///
  /// A timestamp rather than a boolean, because *when* is the question asked
  /// afterwards. "This account's tokens were all revoked at 03:14" is an incident;
  /// `revoked = true` is a flag that says nothing about it.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// The token this one was rotated into, or null if it was never used.
  ///
  /// **This column is the reuse detector.** Rotation means a refresh token is
  /// good exactly once: presenting it returns a new one and marks this row spent.
  /// So a request that presents a token which already has a successor is not a
  /// client retrying — the legitimate holder moved on to the successor — it is a
  /// second party holding a copy of a token that was captured before it was used.
  /// The application cannot tell which of the two is the thief, so it revokes the
  /// whole family and both are made to log in again, which is the only safe
  /// answer.
  ///
  /// Deliberately *not* a Prisma relation. A self-relation would require a
  /// back-reference field and an index for a link that is only ever read forwards,
  /// by an incident investigation, and a foreign key would make deleting an
  /// expired row depend on its successor being deleted first — turning routine
  /// cleanup into an ordering problem for the sake of a pointer.
  replacedById String? @map("replaced_by_id")

  /// When the token expires regardless of anything else — `JWT_REFRESH_TTL` after
  /// it was issued.
  ///
  /// An instant, so `@db.Timestamptz(3)`. Checked in the application rather than
  /// enforced by the database, because "expired" and "revoked" must be
  /// distinguishable while investigating, and a row that deleted itself would be
  /// indistinguishable from one that never existed.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// The client the token was issued to, as it described itself.
  ///
  /// Both are context for the moment somebody asks "what were these sessions?" —
  /// after a reuse detection, or when a person reports a login they do not
  /// recognise. Neither is trusted for anything: a `User-Agent` is whatever the
  /// caller typed, and an address behind a proxy is the proxy's. Nullable because
  /// a client need not send either, and an absent value must not be recorded as
  /// the string "unknown".
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Every live token of one account — what logout, reuse detection and
  /// deactivation all revoke, and what the expiry sweep counts.
  @@index([userId])
  @@map("refresh_tokens")
}

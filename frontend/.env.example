# =============================================================================
# Frontend environment template.
#
# Copy to `.env` in this directory (`frontend/`) and adjust:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# The frontend keeps its own env file rather than reading the repository root
# one, because Vite inlines every `VITE_`-prefixed variable into the shipped
# JavaScript bundle. Anything in here is PUBLIC once the app is built — never
# put a secret, a database URL or an API key in this file.
#
# `.env` is gitignored. Every variable below has a working default, so the app
# and the codegen both run with no `.env` at all in local development.
# =============================================================================

# Optional. The ORIGIN the API is served from — not a path prefix.
#
# Defaults to empty, meaning same-origin. In development the Vite proxy (see
# `vite.config.ts`) forwards `/api` to VITE_API_PROXY_TARGET, so the browser
# never makes a cross-origin request and there is no CORS to configure. In
# production a reverse proxy serves both applications from one origin and the
# default is still correct.
#
# `/api/v1` is NOT part of this value: it is part of every path in the OpenAPI
# document, so the typed client already sends it. Putting it here too would
# produce `/api/v1/api/v1/…`, and it would freeze the API version into the
# deployment configuration — the document describes every version the API
# serves, and a future `/api/v2` route must be reachable through this same
# client.
#
# Set an absolute origin (e.g. https://api.example.com) only when the API
# genuinely lives somewhere else.
VITE_API_BASE_URL=

# Optional. Where the Vite dev server forwards `/api` during local development.
#
# Read by `vite.config.ts` only — it never reaches the browser. Match the
# backend's PORT from the repository root `.env` (defaults to 3000).
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional. The OpenAPI document `npm run gen:api` reads.
#
# The backend must be running and SWAGGER_ENABLED must not be "false". The
# document is served outside `/api/v1` on purpose — it describes every version
# the API serves — so this is NOT under VITE_API_BASE_URL.
VITE_OPENAPI_URL=http://localhost:3000/api/docs-json

# Secrets
# Ignore every .env variant, then re-include the committed template.
# The broad pattern means a future .env.production / .env.staging is ignored
# by default rather than by remembering to add it here.
.env
.env.*
!.env.example

# Node
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*

# Prisma
backend/prisma/*.db
backend/prisma/migrations/dev/

# Generated Prisma Client. Derived from schema.prisma, rebuilt by
# `prisma generate` (wired to `postinstall`), so it is build output rather
# than source. Committed migrations under backend/prisma/migrations/ are NOT
# ignored — they are the schema's history and must be shared.
backend/src/generated/

# Docker
# Database data lives in the named volume `crm-timesheet-postgres-data`,
# managed by Docker outside the repository, so there is nothing to ignore
# for it. These patterns cover bind-mount / dump directories added by hand.
pgdata/
postgres-data/
*.dump
*.sql.gz

# Temporary files
tmp/
temp/
*.tmp
*.bak
*~

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
